{
  "name": "web-portfolio",
  "type": "module",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/.bin/astro dev",
    "build": "astro build",
    "preview": "node --env-file=.env ./node_modules/.bin/astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "astro check",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:styles": "stylelint \"src/**/*.{css,astro}\"",
    "lint:code": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint:code -- --fix && npm run lint:styles -- --fix"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@iconify-json/mdi": "^1.2.3",
    "astro": "^7.2.2",
    "astro-icon": "^1.1.5",
    "nodemailer": "^9.0.5",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.12.0",
    "postcss-html": "2.0.0",
    "stylelint": "17.15.0",
    "stylelint-config-recommended": "18.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.1.10"
  }
}
