#!/bin/bash
# Git Pre-Commit Hook - Local quality checks
# Installation: git config core.hooksPath .githooks

set -e

echo "### Pre-commit checks... "

# 1. Tests (required)
npm run test:run > /dev/null 2>&1 || {
    echo "### Tests failed"
    exit 1
}
echo "### Tests passed"

# 2. TypeScript (required)
npm run typecheck > /dev/null 2>&1 || {
    echo "### TypeScript errors"
    exit 1
}
echo "### TypeScript OK"

# 3. ESLint and Stylelint (required)
npm run lint || {
    echo "### Lint checks failed"
    exit 1
}
echo "### Lint checks passed"

# Note: Trivy and Semgrep scan runs in CI only
# You can do them manually before commit if needed

echo "### Ready to commit"
exit 0

