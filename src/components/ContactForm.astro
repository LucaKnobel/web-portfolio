---
import { actions } from "astro:actions";
import PageSection from "@/components/PageSection.astro";
import { rateLimiter } from "@/server/infrastructure/composition.js";
import type { Language, Translator } from "@/i18n/utils";

export interface ContactFormProps {
    /** Current language (e.g., 'de' or 'en') */
    lang: Language;
    /** Translation function for UI strings */
    t: Translator;
}

const { lang, t } = Astro.props as ContactFormProps;

const rateLimit = rateLimiter.getStatus();
const rateLimitReached = !rateLimit.allowed;

const result = Astro.getActionResult(actions.sendMail);

// Check if we have a successful result
const isSuccess = result?.data?.success === true;
const isError = result?.error;
const isRateLimit = result?.error?.code === "TOO_MANY_REQUESTS";
---


<PageSection title={t("contact.formTitle")}>
    <p class="form-description">{t("contact.formDescription")}</p>

    <!-- Success Message -->
    {isSuccess && (
        <div class="message success">
            <h2>{t("contact.successMessage")}</h2>
        </div>
    )}

    <!-- Rate Limit Reached (on page load) -->
    {rateLimitReached && !isSuccess && (
        <div class="message error">
            <h2>{t("contact.rateLimit")}</h2>
        </div>
    )}

    <!-- Error Message (only for actual submission errors) -->
    {isError && !rateLimitReached && (
        <div class="message error">
            <h2>
                {isRateLimit 
                    ? t("contact.rateLimit")
                    : t("contact.errorMessage")
                }
            </h2>
        </div>
    )}

    <!-- Contact Form - hide if rate limit reached OR successful -->
    {!isSuccess && !rateLimitReached && (
        <form method="post" action={actions.sendMail}>
        <!-- Submit draft / action draft -->
        <!-- Honeypot field for spam protection -->
        <div aria-hidden="true" hidden>
            <label for="website">Website (leave empty):</label>
            <input
                type="text"
                id="website"
                name="website"
                tabindex="-1"
                autocomplete="off"
                value=""
            />
        </div>

        <!-- Personal Information -->
        <fieldset class="personal-fields">
            <legend>{t("contact.personalLegend")}</legend>
            <div class="field">
                <label for="firstName">
                    {t("contact.firstName")}*
                </label>
                    <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    minlength="2"
                    maxlength="50"
                    required
                    autocomplete="given-name"
                />
            </div>

            <div class="field">
                <label for="lastName">
                    {t("contact.lastName")}*
                </label>
                <input
                    type="text"
                    id="lastName"
                    name="lastName"
                    minlength="2"
                    maxlength="60"
                    required
                    autocomplete="family-name"
                />
            </div>

            <div class="field">
                <label for="email">
                    {t("contact.email")}*
                </label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    maxlength="254"
                    autocomplete="email"
                />
            </div>

            <div class="field">
                <label for="company">
                    {t("contact.company")}
                </label>
                <input
                    type="text"
                    id="company"
                    name="company"
                    maxlength="100"
                    autocomplete="organization"
                />
            </div>

            <div class="field">
                <label for="phone">
                    {t("contact.phone")}
                </label>
                <input
                    type="tel"
                    inputmode="tel"
                    id="phone"
                    name="phone"
                    autocomplete="tel"
                    maxlength="20"
                />
            </div>
        </fieldset>

        <!-- Message Details -->
        <fieldset class="message-fields">
            <legend>{t("contact.messageLegend")}</legend>

            <div class="field">
                <label for="subject">
                    {t("contact.subject")}*
                </label>
                    <input
                    type="text"
                    id="subject"
                    name="subject"
                    required
                    maxlength="100"
                    placeholder={t("contact.subjectPlaceholder")}
                />
            </div>

            <div class="field field-wide">
                <label for="message">
                    {t("contact.message")}*
                </label>
                <textarea
                    id="message"
                    name="message"
                    required
                    rows="6"
                    maxlength="3000"
                    placeholder={t("contact.messagePlaceholder")}></textarea>
            </div>
        </fieldset>

        <!-- Privacy Consent -->
        <fieldset class="privacy-fields">
            <legend>{t("contact.privacyLegend")}</legend>

            <div class="privacy-field">
                <div class="checkbox-row">
                    <input
                        type="checkbox"
                        id="privacy"
                        name="privacy"
                        required
                    />
                    <label for="privacy">
                        {t("contact.privacyAccept")}*
                    </label>
                </div>
                <div class="privacy-link">
                    <a
                        href={`/${lang}/privacy-policy`}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {t("nav.privacyPolicy")}
                    </a>
                </div>
            </div>
        </fieldset>

        <button type="submit">
            {t("contact.send")}
        </button>
    </form>
    )}
</PageSection>

<style>
    .form-description {
        margin: 0;
        color: var(--color-muted);
    }

    .message {
        padding: var(--space-6);
        border-radius: var(--card-radius);
        border: 1px solid;

        h2 {
            font-size: var(--heading-sm);
            font-weight: var(--fw-semibold);
            margin-bottom: 0;
        }
    }

    .success {
        background: var(--msg-success-bg);
        border-color: var(--msg-success-border);
        color: var(--msg-success-fg);
    }

    .error {
        background: var(--msg-error-bg);
        border-color: var(--msg-error-border);
        color: var(--msg-error-fg);
    }

    form {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        container: contact-form / inline-size;
        color: var(--color-text);
    }

    /* Honeypot hidden */
    [aria-hidden="true"] {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
    }

        fieldset {
        border: 1px solid var(--color-border);
        border-radius: var(--card-radius);
        padding: var(--space-6);
        background: var(--color-surface-1);
        margin: 0;

        legend {
            font-weight: var(--fw-semibold);
            font-size: var(--heading-xs);
            padding: 0 var(--space-3);
            margin-bottom: var(--space-3);
        }

        div {
            display: flex;
            flex-direction: column;
            gap: var(--space-2);
            margin-bottom: var(--space-4);

            &:last-child {
                margin-bottom: 0;
            }
        }
    }

    .privacy-field {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);

        .checkbox-row {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: var(--space-3);
        }

        .privacy-link {
            padding-left: calc(var(--touch-target-min) + var(--space-3));
        }
    }

    label {
        font-weight: var(--fw-medium);
        color: var(--color-text);
    }

    input,
    textarea {
        width: 100%;
        height: var(--control-h-md);
        padding: var(--space-3);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-bg);
        color: var(--color-text);
        font-size: var(--text-body);

        &:focus-visible {
            border-color: var(--color-primary);
        }
    }

    textarea {
        height: auto;
        min-height: calc(var(--control-h-md) * 5);
    }

    input[type="checkbox"] {
        width: var(--touch-target-min);
        height: var(--touch-target-min);
        margin: 0;
        cursor: pointer;
        accent-color: var(--color-primary);
    }

    button {
        width: 100%;
        height: var(--control-h-lg);
        padding: 0 var(--space-8);
        background: var(--grad-primary-soft);
        color: var(--color-on-primary);
        border: none;
        border-radius: var(--button-radius);
        font-weight: var(--fw-medium);
        font-size: var(--text-body);
        cursor: pointer;
        margin-top: var(--space-6);
        display: flex;
        align-items: center;
        justify-content: center;

        @media (prefers-reduced-motion: no-preference) {
            &:hover {
                transform: translateY(-1px);
            }
        }
    }

    a {
        color: var(--color-link);
        text-decoration: underline;

        &:hover {
            color: var(--color-link-hover);
        }
    }

    @container contact-form (width >= 45rem) {
        button {
            width: auto;
            align-self: flex-end;
        }

        .personal-fields,
        .message-fields {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--space-4);

            legend {
                grid-column: 1 / -1;
            }

            div {
                margin-bottom: 0;
            }
        }

        /* Full width fields */
        .field-wide {
            grid-column: 1 / -1;
        }
    }
</style>

