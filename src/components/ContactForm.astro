---
import { actions } from "astro:actions";
import { Icon } from "astro-icon/components";
import { rateLimiter } from "@/server/infrastructure/composition.js";
import type { Language, Translator } from "@/i18n/utils";

export interface ContactFormProps {
    /** Current language (e.g., 'de' or 'en') */
    lang: Language;
    /** Translation function for UI strings */
    t: Translator;
}

const { lang, t } = Astro.props as ContactFormProps;

const rateLimit = rateLimiter.getStatus();
const rateLimitReached = !rateLimit.allowed;

const result = Astro.getActionResult(actions.sendMail);

// Check if we have a successful result
const isSuccess = result?.data?.success === true;
const isError = result?.error;
const isRateLimit = result?.error?.code === "TOO_MANY_REQUESTS";
---


<section class="contact-page container" aria-labelledby="contact-title">
    <header class="contact-header">
    <h1 id="contact-title">{t("contact.pageTitle")}</h1>
    <p class="form-description">{t("contact.formDescription")}</p>
    </header>

    <!-- Success Message -->
    {isSuccess && (
        <div class="message success" role="status">
            <p>{t("contact.successMessage")}</p>
        </div>
    )}

    <!-- Rate Limit Reached (on page load) -->
    {rateLimitReached && !isSuccess && (
        <div class="message error" role="alert">
            <p>{t("contact.rateLimit")}</p>
        </div>
    )}

    <!-- Error Message (only for actual submission errors) -->
    {isError && !rateLimitReached && (
        <div class="message error" role="alert">
            <p>
                {isRateLimit 
                    ? t("contact.rateLimit")
                    : t("contact.errorMessage")
                }
            </p>
        </div>
    )}

    <!-- Contact Form - hide if rate limit reached OR successful -->
    {!isSuccess && !rateLimitReached && (
        <form method="post" action={actions.sendMail}>
        <!-- Submit draft / action draft -->
        <!-- Honeypot field for spam protection -->
        <div aria-hidden="true" hidden>
            <label for="website">Website (leave empty):</label>
            <input
                type="text"
                id="website"
                name="website"
                tabindex="-1"
                autocomplete="off"
                value=""
            />
        </div>

        <!-- Personal Information -->
        <fieldset class="personal-fields">
            <legend>{t("contact.personalLegend")}</legend>
            <div class="personal-grid">
            <div class="field">
                <label for="firstName">
                    {t("contact.firstName")}*
                </label>
                    <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    minlength="2"
                    maxlength="50"
                    required
                    autocomplete="given-name"
                />
            </div>

            <div class="field">
                <label for="lastName">
                    {t("contact.lastName")}*
                </label>
                <input
                    type="text"
                    id="lastName"
                    name="lastName"
                    minlength="2"
                    maxlength="60"
                    required
                    autocomplete="family-name"
                />
            </div>

            <div class="field field-wide">
                <label for="email">
                    {t("contact.email")}*
                </label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    maxlength="254"
                    autocomplete="email"
                />
            </div>

            <div class="field">
                <label for="company">
                    {t("contact.company")}
                </label>
                <input
                    type="text"
                    id="company"
                    name="company"
                    maxlength="100"
                    autocomplete="organization"
                />
            </div>

            <div class="field">
                <label for="phone">
                    {t("contact.phone")}
                </label>
                <input
                    type="tel"
                    inputmode="tel"
                    id="phone"
                    name="phone"
                    autocomplete="tel"
                    maxlength="20"
                />
            </div>
            </div>
        </fieldset>

        <!-- Message Details -->
        <fieldset class="message-fields">
            <legend>{t("contact.messageLegend")}</legend>

            <div class="field">
                <label for="subject">
                    {t("contact.subject")}*
                </label>
                    <input
                    type="text"
                    id="subject"
                    name="subject"
                    required
                    minlength="1"
                    maxlength="100"
                    placeholder={t("contact.subjectPlaceholder")}
                />
            </div>

            <div class="field field-wide">
                <label for="message">
                    {t("contact.message")}*
                </label>
                <textarea
                    id="message"
                    name="message"
                    required
                    minlength="1"
                    rows="6"
                    maxlength="3000"
                    placeholder={t("contact.messagePlaceholder")}></textarea>
            </div>
        </fieldset>

        <!-- Privacy Consent -->
        <fieldset class="privacy-fields">
            <legend>{t("contact.privacyLegend")}</legend>

            <div class="privacy-field">
                <div class="checkbox-row">
                    <input
                        type="checkbox"
                        id="privacy"
                        name="privacy"
                        required
                    />
                    <label for="privacy">
                        {t("contact.privacyAccept")}*
                    </label>
                </div>
                <div class="privacy-link">
                    <a
                        href={`/${lang}/privacy-policy`}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {t("nav.privacyPolicy")}
                    </a>
                </div>
            </div>
        </fieldset>

        <button type="submit">
            <Icon name="mdi:send-outline" aria-hidden="true" />
            {t("contact.send")}
        </button>
    </form>
    )}
</section>

<style>
    .contact-page {
        max-inline-size: 48rem;
        display: grid;
        gap: var(--space-10);
        padding-block: var(--space-16) calc(var(--space-16) + var(--space-12));
        overflow-wrap: anywhere;
    }

    .contact-header {
        display: grid;
        gap: var(--space-4);
    }

    .contact-header h1 {
        margin: 0;
        font-size: 2.5rem;
        letter-spacing: 0;
    }

    .form-description {
        margin: 0;
        max-inline-size: var(--measure);
        color: var(--color-muted);
    }

    .message {
        padding: var(--space-5);
        border-radius: var(--radius-md);
        border: var(--border-hairline) solid;
    }

    .message p {
        margin: 0;
    }

    .success {
        background: var(--msg-success-bg);
        border-color: var(--msg-success-border);
        color: var(--msg-success-fg);
    }

    .error {
        background: var(--msg-error-bg);
        border-color: var(--msg-error-border);
        color: var(--msg-error-fg);
    }

    form {
        display: flex;
        flex-direction: column;
        gap: var(--space-10);
        container: contact-form / inline-size;
        min-inline-size: 0;
    }

    fieldset {
        min-inline-size: 0;
        border: 0;
        margin: 0;
        padding: 0;
    }

    legend {
        padding: 0;
        margin-block-end: var(--space-5);
        font-size: 1.125rem;
        font-weight: var(--fw-semibold);
        letter-spacing: 0;
    }

    .personal-grid {
        display: grid;
        gap: var(--space-5);
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        min-inline-size: 0;
    }

    .message-fields .field + .field {
        margin-block-start: var(--space-5);
    }

    label {
        font-size: var(--text-small);
        font-weight: var(--fw-medium);
    }

    input:not([type="checkbox"]),
    textarea {
        inline-size: 100%;
        min-block-size: var(--control-h-lg);
        padding: var(--space-3);
        border: var(--border-hairline) solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface-1);
        color: var(--color-text);
        font-size: var(--text-body);
        transition: border-color var(--dur-1) var(--ease-standard);
    }

    textarea {
        min-block-size: 12rem;
        resize: vertical;
    }

    input:focus-visible,
    textarea:focus-visible {
        border-color: var(--color-link);
    }

    input::placeholder,
    textarea::placeholder {
        color: var(--color-muted);
        opacity: 1;
    }

    .privacy-fields {
        border-block-start: var(--border-hairline) solid var(--color-border-hairline);
        padding-block-start: var(--space-5);
    }

    .privacy-fields legend {
        margin: 0;
        padding-inline-end: var(--space-3);
    }

    .checkbox-row {
        display: flex;
        align-items: flex-start;
        gap: var(--space-3);
    }

    input[type="checkbox"] {
        flex-shrink: 0;
        inline-size: var(--icon-xs);
        block-size: var(--icon-xs);
        margin: var(--space-3) 0 0;
        accent-color: var(--color-primary);
        cursor: pointer;
    }

    .checkbox-row label {
        min-block-size: var(--touch-target-min);
        padding-block: var(--space-3);
        font-weight: var(--fw-regular);
        cursor: pointer;
    }

    .privacy-link {
        padding-inline-start: calc(var(--icon-xs) + var(--space-3));
    }

    .privacy-link a {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--touch-target-min);
        font-size: var(--text-small);
        text-decoration: underline;
        text-underline-offset: var(--space-1);
    }

    button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        min-block-size: var(--control-h-lg);
        padding: var(--space-3) var(--space-6);
        border: var(--border-hairline) solid transparent;
        border-radius: var(--button-radius);
        background: var(--color-primary);
        color: var(--color-on-primary);
        font-weight: var(--fw-medium);
        font-size: var(--text-body);
        cursor: pointer;
        transition: background-color var(--dur-1) var(--ease-standard);
    }

    button [data-icon] {
        inline-size: var(--icon-xs);
        block-size: var(--icon-xs);
        flex-shrink: 0;
    }

    @media (hover: hover) {
        button:hover {
            background: var(--color-primary-hover);
        }
    }

    @container contact-form (width >= 36rem) {
        .personal-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .field-wide {
            grid-column: 1 / -1;
        }

        button {
            align-self: flex-start;
            min-inline-size: 10rem;
        }
    }
</style>
