---
import CareerCard from "@/components/career/CareerCard.astro";
import { getCollection } from "astro:content";
import type { Language, Translator } from "@/i18n/utils";

export interface Props {
  /** Current language (e.g., 'de' or 'en')*/
  lang: Language;
  /** Translation function for UI strings */
  t: Translator;
  /** Section type: 'professional' for work experience, 'education' for education */
  type: "professional" | "education";
  /** Section title (displayed as heading)*/
  title: string;
}

const { lang, t, type, title } = Astro.props;

let entries;
if (type === "education") {
  const allEducationEntries = await getCollection("education");
  const educationFile = allEducationEntries.find(
    (entry) => entry.id === lang,
  );
  entries = educationFile?.data || [];
} else {
  const allCareerEntries = await getCollection("career");
  const careerFile = allCareerEntries.find((entry) => entry.id === lang);
  entries = careerFile?.data || [];
}

---

<section class="career-section" id={type} aria-labelledby={`${type}-heading`}>
  <h2 id={`${type}-heading`}>{title}</h2>
  <ol class="career-list" role="list">
    {entries.map((entry) => (
      <li><CareerCard t={t} entry={entry} type={type} /></li>
    ))}
  </ol>
</section>

<style>
  .career-section {
    min-inline-size: 0;
    scroll-margin-block-start: calc(var(--header-height) + var(--space-6));
  }

  .career-section h2 {
    margin: 0 0 var(--space-8);
    font-size: 1.5rem;
    letter-spacing: 0;
  }

  .career-list {
    container-type: inline-size;
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-start: var(--border-hairline) solid var(--color-border);
  }

  .career-list > li {
    border-block-end: var(--border-hairline) solid var(--color-border-hairline);
  }
</style>
