---
import ContactForm from "@/components/ContactForm.astro";
import type { Language, Translator, TranslationKey } from "@/i18n/utils";

interface Props {
  lang: Language;
  t: Translator;
  action: string;
  state: "ready" | "success" | "rate-limited" | "error";
}

const { lang, t, action, state } = Astro.props;
const messages = {
  success: "contact.successMessage",
  "rate-limited": "contact.rateLimit",
  error: "contact.errorMessage",
} satisfies Record<Exclude<Props["state"], "ready">, TranslationKey>;
---

<section class="contact-page container" aria-labelledby="contact-title">
  <header class="contact-header">
    <h1 id="contact-title">{t("contact.pageTitle")}</h1>
    <p class="form-description">{t("contact.formDescription")}</p>
  </header>
  {state !== "ready" && (
    <div class:list={["message", state === "success" ? "success" : "error"]} role={state === "success" ? "status" : "alert"}>
      <p>{t(messages[state])}</p>
    </div>
  )}
  {(state === "ready" || state === "error") && <ContactForm lang={lang} t={t} action={action} />}
</section>

<style>
  .contact-page {
      max-inline-size: 48rem;
      display: grid;
      gap: var(--space-10);
      padding-block: var(--space-16) calc(var(--space-16) + var(--space-12));
      overflow-wrap: anywhere;
  }

  .contact-header {
      display: grid;
      gap: var(--space-4);
  }

  .contact-header h1 {
      margin: 0;
      font-size: 2.5rem;
      letter-spacing: 0;
  }

  .form-description {
      margin: 0;
      max-inline-size: var(--measure);
      color: var(--color-muted);
  }

  .message {
      padding: var(--space-5);
      border-radius: var(--radius-md);
      border: var(--border-hairline) solid;
  }

  .message p {
      margin: 0;
  }

  .success {
      background: var(--msg-success-bg);
      border-color: var(--msg-success-border);
      color: var(--msg-success-fg);
  }

  .error {
      background: var(--msg-error-bg);
      border-color: var(--msg-error-border);
      color: var(--msg-error-fg);
  }

</style>
