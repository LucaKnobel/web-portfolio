---
import { Icon } from "astro-icon/components";
import IconControl from "@/components/IconControl.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isDark = Astro.cookies.get("theme")?.value === "dark";
---

<IconControl
  class="theme-toggle"
  variant="ghost"
  data-theme-toggle
  role="switch"
  aria-checked={isDark ? "true" : "false"}
  label={t("aria.themeDarkMode")}
>
  <span class="icon-container" aria-hidden="true">
    <Icon name="mdi:white-balance-sunny" class="theme-icon" data-theme-icon="light" data-hidden={isDark} />
    <Icon name="mdi:brightness-3" class="theme-icon" data-theme-icon="dark" data-hidden={!isDark} />
  </span>
</IconControl>

<script>
  type Theme = "light" | "dark";

  const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");

  const getCurrentTheme = (): Theme => {
    const choice = document.documentElement.dataset.theme;
    return choice === "light" || choice === "dark"
      ? choice
      : systemTheme.matches ? "dark" : "light";
  };

  const syncIcons = () => {
    const theme = getCurrentTheme();
    document.querySelectorAll<SVGElement>("[data-theme-icon]").forEach((icon) => {
      icon.dataset.hidden = String(icon.dataset.themeIcon !== theme);
    });
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((toggle) => {
      toggle.setAttribute("aria-checked", String(theme === "dark"));
    });
  };

  syncIcons();
  systemTheme.addEventListener("change", syncIcons);
  document.addEventListener("astro:page-load", syncIcons);

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const toggle = event.target.closest<HTMLButtonElement>(
      "[data-theme-toggle]",
    );
    if (!toggle) return;

    const root = document.documentElement;
    const theme = getCurrentTheme() === "dark" ? "light" : "dark";
    const maxAge = 60 * 60 * 24 * 365;
    const secure = window.location.protocol === "https:" ? "; Secure" : "";

    root.dataset.theme = theme;
    syncIcons();
    document.cookie = `theme=${theme}; Max-Age=${maxAge}; Path=/; SameSite=Lax${secure}`;
  });
</script>

<style>
  .icon-container {
    position: relative;
    width: var(--icon-xs);
    height: var(--icon-xs);
  }

  .theme-icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .theme-icon[data-hidden="true"] {
    display: none;
  }

</style>
