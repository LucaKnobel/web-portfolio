---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isDark = Astro.cookies.get("theme")?.value === "dark";
---

<button
  class="theme-toggle"
  data-theme-toggle
  type="button"
  aria-label={t("aria.themeSelect")}
>
  <span class="icon-container" aria-hidden="true">
    <Icon name="mdi:white-balance-sunny" class="theme-icon" data-theme-icon="light" data-hidden={isDark} />
    <Icon name="mdi:brightness-3" class="theme-icon" data-theme-icon="dark" data-hidden={!isDark} />
  </span>
</button>

<script>
  type Theme = "light" | "dark";

  const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");

  const getCurrentTheme = (): Theme => {
    const choice = document.documentElement.dataset.theme;
    return choice === "light" || choice === "dark"
      ? choice
      : systemTheme.matches ? "dark" : "light";
  };

  const syncIcons = () => {
    const theme = getCurrentTheme();
    document.querySelectorAll<SVGElement>("[data-theme-icon]").forEach((icon) => {
      icon.dataset.hidden = String(icon.dataset.themeIcon !== theme);
    });
  };

  syncIcons();
  systemTheme.addEventListener("change", syncIcons);
  document.addEventListener("astro:page-load", syncIcons);

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const toggle = event.target.closest<HTMLButtonElement>(
      "[data-theme-toggle]",
    );
    if (!toggle) return;

    const root = document.documentElement;
    const theme = getCurrentTheme() === "dark" ? "light" : "dark";
    const maxAge = 60 * 60 * 24 * 365;
    const secure = window.location.protocol === "https:" ? "; Secure" : "";

    root.dataset.theme = theme;
    syncIcons();
    document.cookie = `theme=${theme}; Max-Age=${maxAge}; Path=/; SameSite=Lax${secure}`;
  });
</script>

<style>
  .theme-toggle {
    background: var(--grad-surface-soft);
    border: var(--border-hairline) solid var(--color-border-hairline);
    border-radius: var(--button-radius);
    box-shadow: var(--elev-1);
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min);
    min-width: var(--touch-target-min);
    padding: 0;
    transition:
      background-color var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard),
      transform var(--dur-2) var(--ease-standard);
    position: relative;
    overflow: hidden;
  }

  .theme-toggle:hover {
    background: var(--color-surface-3);
    transform: scale(var(--scale-hover));
    border-color: var(--color-primary);
  }

  .theme-toggle:hover .theme-icon,
  .theme-toggle:focus-visible .theme-icon {
    color: var(--color-primary);
  }

  .theme-toggle:active {
    transform: scale(var(--scale-active));
  }

  .icon-container {
    position: relative;
    width: var(--icon-xs);
    height: var(--icon-xs);
  }

  .theme-icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-text);
    transition: color var(--dur-2) var(--ease-standard);
  }

  .theme-icon[data-hidden="true"] {
    display: none;
  }

</style>
