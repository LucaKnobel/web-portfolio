---
import type { Language, Translator } from "@/i18n/utils";
import PageSection from "@/components/PageSection.astro";

export interface ImprintSectionProps {
  /** Language code for constructing localized links */
  lang: Language;
  /** Translation function for UI strings */
  t: Translator;
}

const { lang, t } = Astro.props as ImprintSectionProps;
---

<PageSection title={t("impressum.title")} align="center">
  <div class="impressum-section stack">
    <p>
      {t("impressum.name")}<br />
      {t("impressum.street")}<br />
      {t("impressum.zip")}
      {t("impressum.city")}<br />
      {t("impressum.country")}<br />
      <a href="mailto:knobel.konsum@gmail.com">{t("impressum.email")}</a>
    </p>
    <a href={`/${lang}/privacy-policy`}>{t("impressum.privacy")}</a>
  </div>
</PageSection>

<style>
  .impressum-section {
    text-align: center;
    width: 100%;
    align-items: center;
  }

  p {
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-body);
    line-height: var(--lh);
  }

  a {
    color: var(--color-link);
    text-decoration: underline;
    transition: color var(--dur-1) var(--ease-standard);
    min-height: var(--touch-target-min);
    display: inline-block;
    padding: var(--space-2) var(--space-1);

    &:hover {
      color: var(--color-link-hover);
    }

    &:visited {
      color: var(--color-link-visited);
    }
  }
</style>
