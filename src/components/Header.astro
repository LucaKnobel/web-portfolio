---
import "@/styles/tokens.css";
import "@/styles/base.css";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="header">
  <div class="container">
    <a href={`/${lang}/`} class="logo logo-mobile">Luca Knobel</a>
    <!-- Burger button (only visible on mobile) -->
    <button
      class="burger"
      id="burger-btn"
      aria-label={t("aria.openMenu")}
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-open-label={t("aria.openMenu")}
      data-close-label={t("aria.closeMenu")}
    >
      <Icon
        name="mdi:menu"
        class="burger-icon"
        aria-hidden="true"
        focusable="false"
      />
    </button>
    <!-- Mobile nav overlay -->
    <div id="mobile-menu" class="mobile-menu hidden" hidden>
      <button
        class="close-btn"
        id="close-menu"
        type="button"
        aria-label={t("aria.closeMenu")}
      >
        <Icon name="mdi:close" class="close-icon" />
      </button>

      <nav class="nav-mobile" aria-label={t("aria.navMain")}>
        <div class="nav-links">
          <a href={`/${lang}/projects`}>{t("nav.projects")}</a>
          <a href={`/${lang}/career`}>{t("nav.career")}</a>
          <a href={`/${lang}/contact`}>{t("nav.contact")}</a>
        </div>

        <div class="mobile-selects">
          <select
            onchange="location.href=this.value"
            aria-label={t("aria.languageSelect")}
          >
            <option value="/de/" selected={lang === "de"}>🌐 Deutsch</option>
            <option value="/en/" selected={lang === "en"}>🌐 English</option>
          </select>

          <select class="theme-select" aria-label={t("aria.themeSelect")}>
            <option value="light">☀️ {t("theme.light")}</option>
            <option value="dark">🌙 {t("theme.dark")}</option>
          </select>
        </div>
      </nav>
    </div>
    <!-- Desktop nav -->
    <nav class="nav-desktop" aria-label={t("aria.navMain")}>
      <a href={`/${lang}/`} class="logo">Luca Knobel</a>
      <a href={`/${lang}/projects`}>{t("nav.projects")}</a>
      <a href={`/${lang}/career`}>{t("nav.career")}</a>
      <a href={`/${lang}/contact`}>{t("nav.contact")}</a>
    </nav>
    <div class="desktop-selects">
      <select
        onchange="location.href=this.value"
        aria-label={t("aria.languageSelect")}
      >
        <option value="/de/" selected={lang === "de"}>🌐 Deutsch</option>
        <option value="/en/" selected={lang === "en"}>🌐 English</option>
      </select>
      <select class="theme-select" aria-label={t("aria.themeSelect")}>
        <option value="light">☀️ {t("theme.light")}</option>
        <option value="dark">🌙 {t("theme.dark")}</option>
      </select>
    </div>
  </div>

  <script>
    type Theme = "light" | "dark";

    /* Global toggle function for burger menu */
    const menu = document.getElementById("mobile-menu") as HTMLElement;
    const openBtn = document.getElementById("burger-btn") as HTMLButtonElement;
    const closeBtn = document.getElementById("close-menu") as HTMLButtonElement;

    const setExpanded = (val: boolean) => {
      openBtn.setAttribute("aria-expanded", String(val));
      openBtn.setAttribute(
        "aria-label",
        val ? openBtn.dataset.closeLabel! : openBtn.dataset.openLabel!,
      );
    };

    const open = () => {
      menu.classList.remove("hidden");
      menu.removeAttribute("hidden");
      setExpanded(true);
    };
    const close = () => {
      menu.classList.add("hidden");
      menu.setAttribute("hidden", "");
      setExpanded(false);
      openBtn.focus();
    };

    openBtn.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    document.addEventListener(
      "keydown",
      (e: KeyboardEvent) =>
        e.key === "Escape" && !menu.classList.contains("hidden") && close(),
    );

    /* Theme Change */
    const themeSelects = Array.from(
      document.querySelectorAll<HTMLSelectElement>(".theme-select"),
    );

    const applyTheme = (theme: Theme) => {
      document.documentElement.setAttribute("data-theme", theme);
      document.cookie = `theme=${theme}; path=/; max-age=${60 * 60 * 24 * 365}; SameSite=Lax; Secure`;
      themeSelects.forEach((select) => {
        select.value = theme;
      });
    };

    const current =
      (document.documentElement.getAttribute("data-theme") as Theme) || "light";
    applyTheme(current);

    themeSelects.forEach((select) => {
      select.addEventListener("change", () => {
        applyTheme(select.value as Theme);
      });
    });
  </script>

  <style>
    .header {
      position: sticky;
      top: 0;
      z-index: 100;
      background-color: var(--color-bg);
      box-shadow: 0 2px 8px var(--color-shadow);
      padding: var(--spacing-sm) var(--spacing-md);

      .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        min-height: 45px;

        .logo {
          font-size: var(--font-size-h4);
          font-weight: bold;
          color: var(--color-text);
          text-decoration: none;
          height: 45px;
          display: flex;
          align-items: center;
          justify-content: center;
        }

        .burger {
          background: none;
          border: none;
          color: var(--color-text);
          cursor: pointer;
          padding: 0;
          width: 45px;
          height: 45px;
          display: flex;
          align-items: center;
          justify-content: center;

          .burger-icon {
            width: 28px;
            height: 28px;
            flex-shrink: 0;
          }
        }

        #mobile-menu {
          position: fixed;
          inset: 0;
          z-index: 200;
          background-color: var(--color-bg);
          display: flex;
          flex-direction: column;
          padding: var(--spacing-lg);

          &.hidden {
            display: none;
          }

          .close-btn {
            position: absolute;
            top: var(--spacing-sm);
            right: var(--spacing-sm);
            width: 45px;
            height: 45px;
            background: none;
            border: none;
            color: var(--color-text);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            & .close-icon {
              width: 28px;
              height: 28px;
              flex-shrink: 0;
            }
          }

          .nav-mobile {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;

            .nav-links {
              display: flex;
              flex-direction: column;
              align-items: center;
              gap: var(--spacing-md);
              margin-top: 10vh;

              a {
                font-size: var(--font-size-h4);
                color: var(--color-text);
                text-decoration: none;
                font-weight: bold;
              }
            }

            .mobile-selects {
              display: flex;
              gap: var(--spacing-md);
              justify-content: center;

              select {
                background: var(--select-gradient-bg);
                color: var(--select-text);
                border: 1px solid var(--select-border);
                font-family: var(--font-family);
                font-size: var(--font-size-p);
                padding: 0.5rem 1.25rem 0.5rem 0.75rem;
                border-radius: var(--select-radius);
                transition: border-color 0.2s;
                width: auto;
                min-width: 16ch;
                max-width: 100%;
                text-align: center;
                text-align-last: center;
                text-overflow: ellipsis;
                option {
                  background-color: var(--color-bg);
                  color: var(--select-text);
                  text-align: left;
                }
              }
            }
          }
        }

        .nav-desktop,
        .desktop-selects {
          display: none;
        }
      }

      @media (min-width: 1024px) {
        .container {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: var(--spacing-md);

          .burger,
          .logo-mobile,
          #mobile-menu {
            display: none !important;
          }

          .nav-desktop {
            display: flex;
            align-items: center;
            gap: var(--spacing-md);

            a {
              font-size: var(--font-size-h5);
              color: var(--color-text);
              text-decoration: none;
            }
            a:hover {
              scale: 1.05;
            }

            .logo {
              font-size: var(--font-size-h4);
              font-weight: bold;
              color: var(--color-text);
              text-decoration: none;
              height: 45px;
              display: flex;
              align-items: center;
              justify-content: center;
            }
          }

          .desktop-selects {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: var(--spacing-sm);

            select {
              background: var(--select-gradient-bg);
              color: var(--select-text);
              border: 1px solid var(--select-border);
              font-family: var(--font-family);
              font-size: var(--font-size-p);
              width: auto;
              min-width: 10ch;
              max-width: 100%;
              padding: 0.5rem 1.25rem 0.5rem 0.75rem;
              border-radius: var(--select-radius);
              transition: border-color 0.2s;
              text-align: left;
              text-overflow: ellipsis;
              white-space: nowrap;
              option {
                background-color: var(--color-bg);
                color: var(--select-text);
              }
            }
          }
        }
      }
    }
  </style>
</header>
