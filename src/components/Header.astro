---
import { useTranslation } from "@/i18n";
import "@/styles/tokens.css";
import "@/styles/base.css";
const t = useTranslation(Astro.currentLocale ?? "en");
---

<header class="header">
  <div class="container">
    <a href={`/${Astro.currentLocale}/`} class="logo">Luca Knobel</a>

    <!-- Burger button (only visible on mobile) -->
    <button class="burger" onclick="toggleMenu()" aria-label="Open menu">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        viewBox="0 -960 960 960"
        fill="currentColor"
      >
        <path
          d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z"
        ></path>
      </svg>
    </button>

    <!-- Mobile nav overlay -->
    <div id="mobile-menu" class="mobile-menu hidden">
      <button onclick="toggleMenu()" class="close" aria-label="Close menu">
        &times;
      </button>

      <nav class="nav-mobile">
        <div class="nav-links">
          <a href={`/${Astro.currentLocale}/projects`}>{t.nav.projects}</a>
          <a href={`/${Astro.currentLocale}/career`}>{t.nav.career}</a>
          <a href={`/${Astro.currentLocale}/contact`}>{t.nav.contact}</a>
        </div>

        <div class="nav-selects">
          <select onchange="location.href=this.value">
            <option value="/de/" selected={Astro.currentLocale === "de"}>🌐 Deutsch</option
            >
            <option value="/en/" selected={Astro.currentLocale === "en"}>🌐 English</option
            >
          </select>

          <select id="theme-select-mobile">
            <option value="light">☀️ {t.theme.light}</option>
            <option value="dark">🌙 {t.theme.dark}</option>
          </select>
        </div>
      </nav>
    </div>

    <!-- Desktop nav -->
    <nav class="nav-desktop">
      <a href={`/${Astro.currentLocale}/projects`}>{t.nav.projects}</a>
      <a href={`/${Astro.currentLocale}/career`}>{t.nav.career}</a>
      <a href={`/${Astro.currentLocale}/contact`}>{t.nav.contact}</a>

      <select onchange="location.href=this.value">
        <option value="/de/" selected={Astro.currentLocale === "de"}>🌐 Deutsch</option>
        <option value="/en/" selected={Astro.currentLocale === "en"}>🌐 English</option>
      </select>

      <select id="theme-select">
        <option value="light">☀️ {t.theme.light}</option>
        <option value="dark">🌙 {t.theme.dark}</option>
      </select>
    </nav>
  </div>
</header>

<script type="module">
  // Theme handling (shared for both selects)
  const themeSelects = [
    document.getElementById("theme-select"),
    document.getElementById("theme-select-mobile"),
  ].filter(Boolean);

  const applyTheme = (theme) => {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
    themeSelects.forEach((select) => {
      if (select) select.value = theme;
    });
  };

  const current = localStorage.getItem("theme") || "light";
  applyTheme(current);

  themeSelects.forEach((select) => {
    select?.addEventListener("change", () => {
      applyTheme(select.value);
    });
  });

  // Burger menu toggle
  window.toggleMenu = () => {
    const menu = document.getElementById("mobile-menu");
    menu?.classList.toggle("hidden");
  };
</script>

<style>
  /* Header Container */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg);
    box-shadow: 0 2px 8px var(--color-shadow);
    padding: var(--spacing-sm) var(--spacing-md);
  }

  /* Flex Container */
  .header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 45px;
  }

  /* Logo */
  .header .logo {
    font-size: var(--font-size-h4);
    font-weight: bold;
    color: var(--color-text);
    text-decoration: none;
    height: 45px;
    display: flex;
    align-items: center;
    padding: 0;
  }

  /* Burger Button (visible only on mobile) */
  .header .burger {
    font-size: 2rem;
    background: none;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    padding: 0;
    margin: 0;
    width: 45px;
    height: 45px;
    align-items: center;
    display: flex;
    justify-content: center;
  }

  /* Desktop Navigation */
  .header .nav-desktop {
    display: none;
    gap: var(--spacing-sm);
    align-items: center;
  }

  .header .nav-desktop a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--font-size-p);
  }


  /* Mobile Menu Overlay */
  #mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    background-color: var(--color-bg);
    display: flex;
    flex-direction: column;
    padding: var(--spacing-lg);
  }

  #mobile-menu.hidden {
    display: none;
  }

  #mobile-menu .close {
    position: absolute;
    top: var(--spacing-md);
    right: var(--spacing-md);
    width: 45px;
    height: 45px;
    min-width: 45px;
    min-height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    z-index: 10;
  }

 #mobile-menu .close {
  font-size: 2.5rem; 
}

  .nav-mobile {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    width: 100%;
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-md);
    margin-top: 10vh;
  }

  .nav-links a {
    font-size: var(--font-size-h4);
    color: var(--color-text);
    text-decoration: none;
    font-weight: bold;
  }

  .nav-selects {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-lg);
    
  }

.nav-selects select,
.header .nav-desktop select {
  background-color: var(--select-bg);
  color: var(--select-text);
  border: 1px solid var(--color-border);    /* Hier: 2px für deutlicheren, aber dezenten Rahmen */
  font-family: var(--font-family);
  font-size: var(--font-size-p);
  padding: 0.5rem 2rem 0.5rem 1rem;
  border-radius: var(--btn-radius);
  box-shadow: none;
  transition: border-color 0.2s;
}

  /* Desktop Breakpoint */
  @media (min-width: 768px) {
    .header .burger {
      display: none;
    }

    .header .nav-desktop {
      display: flex;
    }

    #mobile-menu {
      display: none !important;
    }
  }
</style>
