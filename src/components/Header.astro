---
import Navigation from "@/components/Navigation.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import LanguageSelect from "@/components/LanguageSelect.astro";
import MobileMenu from "@/components/MobileMenu.astro";
import type { Language, Translator } from "@/i18n/utils";

export interface HeaderProps {
  /** Current language (e.g., 'de' or 'en') */
  lang: Language;
  /** Translation function for UI strings */
  t: Translator;
}

const { lang, t } = Astro.props as HeaderProps;

/* Main navigation links */
const headerLinks = [
  { href: `/${lang}/projects`, label: t("nav.projects") },
  { href: `/${lang}/career`, label: t("nav.career") },
  { href: `/${lang}/contact`, label: t("nav.contact") },
];
---

<header class="site-header">
  <div class="header-container container">
    <!-- Brand/Logo section -->
    <div class="header-brand">
      <a href={`/${lang}`} class="brand-link">
        <span class="brand-text">Luca Knobel</span>
      </a>
    </div>
    <!-- Desktop navigation - visible on larger screens -->
    <div class="header-nav desktop-nav">
      <Navigation links={headerLinks} />
    </div>

    <!-- Header controls - theme, language, mobile menu -->
    <div class="header-controls">
      <!-- Desktop controls - only visible on larger screens -->
      <div class="desktop-controls">
        <!-- Language selector - desktop only -->
        <LanguageSelect />

        <!-- Theme toggle - desktop only -->
        <ThemeToggle />
      </div>

      <!-- Mobile menu toggle - visible on small screens -->
      <div class="mobile-controls">
        <MobileMenu links={headerLinks}>
          <LanguageSelect />
          <ThemeToggle />
        </MobileMenu>
      </div>
    </div>
  </div>
</header>

<script>
  const initStickyHeader = () => {
    const header = document.querySelector<HTMLElement>(".site-header");
    if (!header) return;

    const updateScrolled = () => {
      const scrolled = window.scrollY > 4;
      if (header.dataset.scrolled !== String(scrolled)) {
        header.dataset.scrolled = String(scrolled);
      }
    };

    updateScrolled();
    window.addEventListener("scroll", updateScrolled, { passive: true });
  };

  initStickyHeader();
  document.addEventListener("astro:page-load", initStickyHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--layer-header);
    padding-block: 0;
    min-height: var(--header-height);
    isolation: isolate;
    border-bottom: var(--border-hairline) solid transparent;
    transition: border-color var(--dur-2) var(--ease-standard);

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background: transparent;
      transition: background-color var(--dur-2) var(--ease-standard);
    }

    /* Once the page has scrolled, the header separates from the content
       beneath it with a readable surface and a faint divider. At rest on
       the landing page it stays flush with the hero underneath it. */
    &[data-scrolled="true"] {
      border-bottom-color: var(--color-border-hairline);
    }

    .header-container {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: var(--space-4);
      height: var(--header-height);
      position: relative;
      z-index: 1;
    }
  }

  .site-header[data-scrolled="true"]::before {
    background: var(--color-bg);

    /* Keep the prefixed and standard declarations separate: Lightning CSS
     * otherwise drops one when both use the same custom property. */
    @supports (-webkit-backdrop-filter: blur(1px)) {
      background: var(--glass-bg);
      -webkit-backdrop-filter: var(--glass-blur);
    }

    @supports (backdrop-filter: blur(1px)) {
      background: var(--glass-bg);
      backdrop-filter: var(--glass-blur);
    }
  }

  /* Brand/Logo section */
  .header-brand {
    grid-column: 1;
    justify-self: start;
    min-width: 0;

    .brand-link {
      color: var(--color-text);
      text-decoration: none;
      font-weight: var(--fw-semibold);
      font-size: var(--heading-xs);
      line-height: 1.1;
      transition: color var(--dur-2) var(--ease-standard);

      &:hover {
        color: var(--color-primary);
      }
    }
  }

  /* Desktop navigation - hidden on mobile. Placed in the middle grid track
     so it is truly centered in the header, independent of how wide the
     brand and utility groups are. */
  .desktop-nav {
    display: none;
    grid-column: 2;
  }

  /* Header controls section */
  .header-controls {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;

    /* Desktop controls - hidden on mobile */
    .desktop-controls {
      display: none;
      align-items: center;
      gap: var(--space-2);
    }

    /* Mobile menu - only visible on small screens */
    .mobile-controls {
      display: block;
    }
  }

  /* Desktop layout */
  @media (min-width: 1024px) {
    .desktop-nav {
      display: flex;
      justify-content: center;
    }

    .header-controls {
      .desktop-controls {
        display: flex;
      }

      .mobile-controls {
        display: none;
      }
    }
  }
</style>
