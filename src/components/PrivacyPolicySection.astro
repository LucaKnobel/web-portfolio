---
export interface PrivacyPolicySectionProps {
  /** Rendered privacy policy content */
  Content: any;
}

const { Content } = Astro.props as PrivacyPolicySectionProps;
---

<section class="privacy-content prose">
  <Content />
</section>

<style>
  .privacy-content {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-12) var(--gutter);
  }
</style>
