---
import { Icon } from "astro-icon/components";
import IconControl from "@/components/IconControl.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

export interface NavLink {
  href: string;
  label: string;
}

export interface Props {
  links: NavLink[];
}

const { links }: Props = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const dialogId = "mobile-navigation";
---

<IconControl
  class="mobile-menu-toggle"
  data-mobile-menu-open
  aria-controls={dialogId}
  label={t("aria.openMenu")}
  variant="ghost"
>
  <Icon name="mdi:menu" class="burger-icon" />
</IconControl>

<dialog class="mobile-menu-dialog" id={dialogId}>
  <div class="mobile-menu-modal">
    <div class="modal-header">
      <div class="header-controls">
        <slot />
        <IconControl
          class="modal-close"
          data-mobile-menu-close
          label={t("aria.closeMenu")}
          autofocus
        >
          <Icon name="mdi:close" class="close-icon" />
        </IconControl>
      </div>
    </div>

    <nav class="modal-nav" aria-label={t("aria.navMain")}>
      <ul class="nav-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="nav-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</dialog>

<script>
  const openMenu = (target: Element) => {
    const dialogId = target.getAttribute("aria-controls");
    if (!dialogId) return;

    const dialog = document.getElementById(dialogId);
    if (dialog instanceof HTMLDialogElement && !dialog.open) {
      dialog.showModal();
    }
  };

  const closeMenu = (target: Element) => {
    const dialog = target.closest("dialog");
    if (dialog instanceof HTMLDialogElement && dialog.open) {
      dialog.close();
    }
  };

  const dialog = document.getElementById("mobile-navigation");
  const trigger = document.querySelector<HTMLButtonElement>(
    '[aria-controls="mobile-navigation"]',
  );

  if (dialog instanceof HTMLDialogElement) {
    dialog.addEventListener("close", () => {
      setTimeout(() => trigger?.focus(), 0);
    });
  }

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const openTrigger = event.target.closest("[data-mobile-menu-open]");
    if (openTrigger) {
      openMenu(openTrigger);
      return;
    }

    const closeTrigger = event.target.closest("[data-mobile-menu-close]");
    if (closeTrigger) closeMenu(closeTrigger);
  });
</script>

<style>
  .burger-icon {
    width: var(--icon-lg);
    height: var(--icon-lg);
  }

  .mobile-menu-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--grad-surface-soft);
    color: var(--color-text);
  }

  .mobile-menu-modal {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .modal-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: var(--space-3) var(--gutter);
    min-height: 60px;
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .close-icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
  }

  .modal-nav {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-list {
    list-style: none;
    width: 100%;
    max-width: 300px;
    margin: 0;
    padding: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .nav-link {
    display: block;
    padding: var(--space-8);
    border: var(--border-hairline) solid transparent;
    border-radius: var(--button-radius);
    color: var(--color-text);
    font-size: var(--heading-xs);
    font-weight: var(--fw-medium);
    text-align: center;
    text-decoration: none;
  }

  .nav-link:hover {
    background: var(--color-surface-2);
    border-color: var(--color-border);
    color: var(--color-primary);
  }
</style>
