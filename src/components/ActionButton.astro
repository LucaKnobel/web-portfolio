---
import { Icon } from "astro-icon/components";

export interface Props {
  /** The URL to navigate to */
  href: string;
  /** Text to display (optional) */
  text?: string;
  /** Icon name from iconify (optional) */
  icon?: string;
  /** Visual variant of the button */
  variant?: "primary" | "gradient";
  /** Additional CSS classes */
  class?: string;
  /** Aria label for accessibility (auto-generated if not provided) */
  ariaLabel?: string;
  /** Button size: m, l, square */
  size?: "m" | "l" | "square";
}

const {
  href,
  text,
  icon,
  variant = "primary",
  class: customClass = "",
  ariaLabel,
  size = "m",
} = Astro.props;

/* Detect if link is external */
const isExternal = href.startsWith("http") || href.startsWith("//");

/* Auto-generate aria-label if not provided */
const computedAriaLabel = ariaLabel || text || `Navigate to ${href}`;

/* Render the supplied text and icon. */
const hasText = !!text;
const hasIcon = !!icon;
---

<a
  href={href}
  class:list={["action-button", customClass]}
  data-variant={variant}
  data-size={size}
  aria-label={computedAriaLabel}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
>
  {hasIcon && <Icon name={icon} class="button-icon" />}
  {hasText && <span class="button-text">{text}</span>}
</a>

<style>
  .action-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    border: var(--border-hairline) solid var(--color-border-hairline);
    border-radius: var(--button-radius);
    color: var(--color-text);
    font-weight: var(--fw-medium);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard),
      color var(--dur-2) var(--ease-standard),
      box-shadow var(--dur-2) var(--ease-standard),
      transform var(--dur-2) var(--ease-standard);
  }

  .action-button[data-size="m"] {
    inline-size: 150px;
    block-size: var(--control-h-lg);
  }

  .action-button[data-size="l"] {
    inline-size: 180px;
    block-size: var(--control-h-xl);
  }

  .action-button[data-size="square"] {
    inline-size: var(--touch-target-min);
    block-size: var(--touch-target-min);
  }

  .action-button:hover {
    transform: scale(var(--scale-hover));
  }

  .action-button:active {
    transform: scale(var(--scale-active));
  }

  .action-button[data-variant="primary"] {
    background: var(--grad-primary-soft);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .action-button[data-variant="primary"]:hover {
    background: linear-gradient(180deg, var(--color-primary-hover), var(--color-primary));
  }

  .action-button[data-variant="gradient"] {
    background: linear-gradient(135deg, var(--color-surface-1), var(--color-surface-2) 50%, var(--color-surface-3));
    box-shadow: var(--elev-1);
    position: relative;
    overflow: hidden;
  }

  .action-button[data-variant="gradient"]::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: -100%;
    inline-size: 100%;
    block-size: 100%;
    background: linear-gradient(135deg, transparent, var(--color-sheen) 50%, transparent);
    transition: inset-inline-start var(--dur-2) var(--ease-standard);
    z-index: 1;
  }

  .action-button[data-variant="gradient"]:hover {
    background: linear-gradient(135deg, var(--color-surface-2), var(--color-surface-3));
    color: var(--color-primary);
    border-color: var(--color-primary);
    box-shadow: var(--elev-2);
  }

  .action-button:hover::before {
    inset-inline-start: 100%;
  }

  .button-icon,
  .button-text {
    position: relative;
    z-index: 2;
  }

  .button-icon {
    flex-shrink: 0;
    inline-size: var(--icon-sm);
    block-size: var(--icon-sm);
  }
</style>
