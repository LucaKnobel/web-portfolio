---
import { Icon } from "astro-icon/components";

export interface Props {
  /** The URL to navigate to */
  href: string;
  /** Text to display (optional) */
  text?: string;
  /** Icon name from iconify (optional) */
  icon?: string;
  /** Visual variant of the button */
  variant?: "primary" | "secondary";
  /** Additional CSS classes */
  class?: string;
  /** Aria label for accessibility (auto-generated if not provided) */
  ariaLabel?: string;
  /** Button size: m, l, square */
  size?: "m" | "l" | "square";
}

const {
  href,
  text,
  icon,
  variant = "primary",
  class: customClass = "",
  ariaLabel,
  size = "m",
} = Astro.props;

/* Detect if link is external */
const isExternal = href.startsWith("http") || href.startsWith("//");

/* Auto-generate aria-label if not provided */
const computedAriaLabel = ariaLabel || text || `Navigate to ${href}`;

/* Render the supplied text and icon. */
const hasText = !!text;
const hasIcon = !!icon;
---

<a
  href={href}
  class:list={["action-button", customClass]}
  data-variant={variant}
  data-size={size}
  aria-label={computedAriaLabel}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
>
  {hasIcon && <Icon name={icon} class="button-icon" aria-hidden="true" />}
  {hasText && <span class="button-text">{text}</span>}
</a>

<style>
  .action-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    max-inline-size: 100%;
    padding: var(--space-2) var(--space-4);
    border: var(--border-hairline) solid var(--color-border-hairline);
    border-radius: var(--button-radius);
    color: var(--color-text);
    font-weight: var(--fw-medium);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease-standard),
      border-color var(--dur-1) var(--ease-standard),
      color var(--dur-1) var(--ease-standard);
  }

  .action-button[data-size="m"] {
    min-inline-size: min(150px, 100%);
    min-block-size: var(--control-h-lg);
  }

  .action-button[data-size="l"] {
    min-inline-size: min(180px, 100%);
    min-block-size: var(--control-h-xl);
  }

  .action-button[data-size="square"] {
    inline-size: var(--touch-target-min);
    block-size: var(--touch-target-min);
    padding: 0;
  }

  .action-button[data-variant="primary"] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .action-button[data-variant="secondary"] {
    background: var(--color-surface-1);
  }

  @media (hover: hover) {
    .action-button[data-variant="primary"]:hover {
      background: var(--color-primary-hover);
    }

    .action-button[data-variant="secondary"]:hover {
      background: var(--color-surface-2);
      color: var(--color-link);
      border-color: var(--color-border);
    }
  }

  .action-button[data-variant="primary"]:active {
    background: var(--color-primary-active);
  }

  .action-button[data-variant="secondary"]:active {
    background: var(--color-surface-3);
  }

  .button-text {
    min-inline-size: 0;
    overflow-wrap: anywhere;
    text-align: center;
  }

  .button-icon {
    flex-shrink: 0;
    inline-size: var(--icon-sm);
    block-size: var(--icon-sm);
  }
</style>
