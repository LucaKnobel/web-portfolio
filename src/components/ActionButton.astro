---
import { Icon } from "astro-icon/components";

export interface Props {
  /** The URL to navigate to */
  href: string;
  /** Text to display (optional) */
  text?: string;
  /** Icon name from iconify (optional) */
  icon?: string;
  /** Visual variant of the button */
  variant?: "primary" | "secondary" | "ghost" | "link" | "gradient";
  /** Size of the button */
  size?: "sm" | "md" | "lg";
  /** Additional CSS classes */
  class?: string;
  /** Aria label for accessibility (auto-generated if not provided) */
  ariaLabel?: string;
}

const { 
  href, 
  text, 
  icon, 
  variant = "secondary", 
  size = "md", 
  class: customClass = "", 
  ariaLabel 
} = Astro.props;

/* Detect if link is external */
const isExternal = href.startsWith("http") || href.startsWith("//");

/* Auto-generate aria-label if not provided */
const computedAriaLabel = ariaLabel || text || `Navigate to ${href}`;

/* Determine if it's text-only, icon-only, or combined */
const hasText = !!text;
const hasIcon = !!icon;
const isIconOnly = hasIcon && !hasText;

/* Build CSS classes */
const classes = [
  "action-button",
  `variant-${variant}`,
  `size-${size}`,
  isIconOnly ? "icon-only" : "",
  customClass
].filter(Boolean).join(" ");
---

<a 
  href={href}
  class={classes}
  aria-label={computedAriaLabel}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
>
  {hasIcon && <Icon name={icon} class="button-icon" />}
  {hasText && <span class="button-text">{text}</span>}
</a>

<style>
  .action-button {
    /* Layout */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--stack-xs);
    
    /* Sizing & Spacing */
    padding: var(--stack-xs) var(--stack-sm);
    min-height: var(--touch-target-min);
    box-sizing: border-box;
    
    /* Visual */
    border: var(--border-hairline) solid var(--color-border-hairline);
    border-radius: var(--button-radius);
    background: transparent;
    
    /* Typography */
    color: var(--color-text);
    font-weight: var(--fw-medium);
    text-decoration: none;
    
    /* Interaction */
    cursor: pointer;
    transition: all var(--dur-2) var(--ease-standard);
  }

  .size-sm {
    padding: var(--stack-xs);
    font-size: var(--text-small);
    min-height: var(--control-h-sm);
  }

  .size-md {
    padding: var(--stack-xs) var(--stack-sm);
    font-size: var(--text-body);
    min-height: var(--control-h-md);
  }

  .size-lg {
    padding: var(--stack-sm) var(--stack-md);
    font-size: var(--heading-xs);
    min-height: var(--control-h-lg);
  }

  .size-sm .button-icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
  }

  .size-md .button-icon {
    width: var(--icon-md);
    height: var(--icon-md);
  }
  .size-lg .button-icon {
    width: var(--icon-lg);
    height: var(--icon-lg);
  }

  .icon-only {
    padding: var(--stack-xs);
    min-width: var(--touch-target-min);
  }

  .icon-only.size-sm { min-width: var(--control-h-sm); }
  .icon-only.size-md { min-width: var(--control-h-md); }
  .icon-only.size-lg { min-width: var(--control-h-lg); }


  /* Primary */
  .variant-primary {
    background: var(--grad-primary-soft);
    border-color: var(--color-primary);
    color: var(--color-on-primary);

    &:hover {
      background: var(--color-primary-hover);
      transform: scale(var(--scale-hover));
    }

    &:active {
      transform: scale(var(--scale-active));
    }
  }

  /* Secondary */
  .variant-secondary {
    background: var(--grad-surface-soft);
    border-color: var(--color-border-hairline);
    color: var(--color-text);

    &:hover {
      background: var(--color-surface-3);
      border-color: var(--color-primary);
      color: var(--color-primary);
      transform: scale(var(--scale-hover));
    }

    &:active {
      transform: scale(var(--scale-active));
    }
  }

  /* Ghost */
  .variant-ghost {
    background: transparent;
    border-color: transparent;
    color: var(--color-text);

    &:hover {
      background: var(--color-surface-2);
      color: var(--color-primary);
      transform: scale(var(--scale-hover));
    }

    &:active {
      transform: scale(var(--scale-active));
    }
  }

  /* Link */
  .variant-link {
    background: transparent;
    border: none;
    color: var(--color-link);
    padding: 0;
    min-height: auto;
    text-decoration: underline;
    text-decoration-color: transparent;

    &:hover {
      color: var(--color-link-hover);
      text-decoration-color: currentColor;
    }
  }

  /* Gradient - Base (Dark Mode) */
  .variant-gradient {
    background: linear-gradient(135deg, 
      var(--color-surface-1) 0%, 
      var(--color-surface-2) 50%, 
      var(--color-surface-3) 100%
    );
    border-color: var(--color-border-hairline);
    color: var(--color-text);
    box-shadow: var(--elev-1);
    position: relative;
    overflow: hidden;

    /* Shine effect overlay */
    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, 
        rgba(255, 255, 255, 0.0) 0%, 
        rgba(255, 255, 255, 0.08) 50%, 
        rgba(255, 255, 255, 0.0) 100%
      );
      transition: left var(--dur-2) var(--ease-standard);
      z-index: 1;
    }

    /* Content layering */
    .button-icon,
    .button-text {
      position: relative;
      z-index: 2;
    }

    /* Hover state */
    &:hover {
      background: linear-gradient(135deg, 
        var(--color-surface-2) 0%, 
        var(--color-surface-3) 100%
      );
      color: var(--color-primary);
      border-color: var(--color-primary);
      transform: scale(var(--scale-hover));
      box-shadow: var(--elev-2);

      &::before {
        left: 100%;
      }
    }

    &:active {
      transform: scale(var(--scale-active));
    }
  }

  /* Gradient - Light Mode Override */
  :root:not([data-theme="dark"]) .variant-gradient {
    background: linear-gradient(135deg, 
      var(--neutral-25) 0%, 
      var(--neutral-50) 50%, 
      var(--neutral-100) 100%
    );
    border-color: var(--neutral-150);
    box-shadow: var(--elev-2);

    &::before {
      background: linear-gradient(135deg, 
        rgba(255, 255, 255, 0.0) 0%, 
        rgba(255, 255, 255, 0.2) 50%, 
        rgba(255, 255, 255, 0.0) 100%
      );
    }

    &:hover {
      background: linear-gradient(135deg, 
        var(--neutral-50) 0%, 
        var(--neutral-100) 50%, 
        var(--neutral-150) 100%
      );
      border-color: var(--color-primary);
      box-shadow: var(--elev-3);
    }
  }

 
  .action-button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .button-icon {
    flex-shrink: 0;
    transition: all var(--dur-2) var(--ease-standard);
  }

  .button-text {
    transition: all var(--dur-2) var(--ease-standard);
  }
</style>