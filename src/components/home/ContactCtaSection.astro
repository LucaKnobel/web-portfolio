---
import type { Language, Translator } from "@/i18n/utils";

export interface Props {
  /** Current language (e.g., 'de' or 'en') */
  lang: Language;
  /** Translation function for UI strings */
  t: Translator;
}

const { lang, t } = Astro.props;
---

<section class="contact-cta" aria-labelledby="contact-cta-heading">
  <div class="container contact-cta-inner stack">
    <h2 id="contact-cta-heading">{t("home.contact.eyebrow")}</h2>
    <p>{t("home.contact.text")}</p>
    <a href={`/${lang}/contact`} class="contact-cta-link">{t("home.contact.link")} →</a>
  </div>
</section>

<style>
  .contact-cta {
    padding-block-start: var(--space-4xl);
    padding-block-end: clamp(6rem, 18dvh, 11rem);
  }

  .contact-cta-inner {
    --flow: var(--space-md);
    align-items: flex-start;
    text-align: left;
    max-width: 60ch;
  }

  .contact-cta-inner h2 {
    margin: 0;
    font-size: var(--text-2xl);
  }

  .contact-cta-inner p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  .contact-cta-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min);
    padding-inline: var(--space-2xs);
    margin-inline-start: calc(var(--space-2xs) * -1);
    color: var(--color-link);
    font-weight: var(--fw-medium);
    text-decoration: none;
  }

  .contact-cta-link:hover,
  .contact-cta-link:focus-visible {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  @media (min-width: 1024px) {
    .contact-cta-inner {
      align-items: center;
      text-align: center;
      max-width: 40rem;
      margin-inline: auto;
    }

    .contact-cta-link {
      margin-inline-start: 0;
    }
  }
</style>
