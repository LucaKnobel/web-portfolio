---
import { formatProjectDate } from "@/content/project-utils";
import ActionButton from "@/components/ActionButton.astro";
import { Image } from "astro:assets";
import type { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { Language, Translator } from "@/i18n/utils";

type Project = CollectionEntry<"projects">;
type ProjectContent = Awaited<ReturnType<typeof render>>["Content"];

export interface ProjectDetailProps {
  /** Project data object */
  project: Project;
  /** Current language (e.g., 'de' or 'en') */
  lang: Language;
  /** Translation function for UI strings */
  t: Translator;
  /** Astro Content component for project details */
  Content: ProjectContent;
}

type Props = ProjectDetailProps;

const { project, lang, t, Content } = Astro.props;
---

<article class="project-detail container stack">
  <header class="project-header">
    <div class="project-meta stack">
      <div class="project-meta-row">
        <a href={`/${lang}/projects`} class="back-link">
          ← {t("nav.projects")}
        </a>
        <span class="project-date">{formatProjectDate(project.data.date)}</span>
      </div>
      <h1 class="project-title">{project.data.title}</h1>
      <div class="project-cover">
        <Image
          src={project.data.cover}
          alt={project.data.title}
          decoding="async"
          format="webp"
          priority
          width="1200"
          height="675"
        />
      </div>
      {
        project.data.url && (
          <ActionButton
            href={project.data.url}
            size="l"
            text="GitHub Repository"
            variant="gradient"
          />
        )
      }
    </div>
  </header>
  <div class="project-content prose">
    <Content />
  </div>
</article>

<style>
  .project-detail {
    --flow: var(--space-8);
    padding-block: var(--space-12);
    background: var(--color-bg);
    overflow-x: hidden;
  }

  .project-meta {
    --flow: var(--space-6);
    align-items: flex-start;
    font-size: var(--text-small);
    color: var(--color-muted);
  }

  .project-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: var(--space-2);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--touch-target-min);
    min-height: var(--touch-target-min);
    padding-inline: var(--space-2);
    border-radius: var(--radius-sm);
    font-weight: var(--fw-medium);
    cursor: pointer;
  }

  .project-date {
    color: var(--color-muted);
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .project-title {
    width: 100%;
    margin: 0;
    color: var(--color-text);
    font-size: var(--display-xl);
    font-weight: var(--fw-semibold);
    overflow-wrap: break-word;
  }

  .project-cover {
    width: 100%;
    overflow: hidden;
    border-radius: var(--card-radius);
    box-shadow: var(--elev-1);
  }

  .project-cover img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
  }

</style>
