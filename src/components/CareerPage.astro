---
import CareerSection from "@/components/CareerSection.astro";
import type { Language, Translator } from "@/i18n/utils";

interface Props {
  lang: Language;
  t: Translator;
}

const { lang, t } = Astro.props;
---

<div class="career-page container">
  <header class="career-page-header">
    <h1>{t("career.pageTitle")}</h1>
    <nav class="career-navigation" aria-label={t("career.pageTitle")}>
      <a href="#professional">{t("career.professionalCareer")}</a>
      <a href="#education">{t("career.education")}</a>
    </nav>
  </header>
  <CareerSection lang={lang} t={t} type="professional" title={t("career.professionalCareer")} />
  <CareerSection lang={lang} t={t} type="education" title={t("career.education")} />
</div>

<style>
  .career-page {
    max-inline-size: 64rem;
    display: grid;
    gap: var(--space-16);
    padding-block: var(--space-16) calc(var(--space-16) + var(--space-12));
  }

  .career-page-header {
    display: grid;
    gap: var(--space-4);
  }

  .career-page-header h1 {
    margin: 0;
    font-size: 2.5rem;
    letter-spacing: 0;
  }

  .career-navigation {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-6);
  }

  .career-navigation a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target-min);
    font-size: var(--text-small);
    text-decoration: underline;
    text-underline-offset: var(--space-1);
  }
</style>
