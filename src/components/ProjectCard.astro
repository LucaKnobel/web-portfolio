---
import { Image } from "astro:assets";

interface ProjectCardProps {
    title: string;
    description: string;
    date: string;
    tags: string[];
    coverSrc: ImageMetadata;
    href: string;
}

const { title, description, date, tags, coverSrc, href } =
    Astro.props as ProjectCardProps;
---

<div class="project-card-outer">
    <a href={href} class="project-card" tabindex="0">
        {
            coverSrc && (
                <Image
                    src={coverSrc}
                    alt={title}
                    class="project-card-cover"
                    loading="lazy"
                    decoding="async"
                    format="webp"
                    width={800}
                    height={450}
                />
            )
        }
        <div class="project-card-content">
            <h2 class="project-card-title">{title}</h2>
            <p class="project-card-desc">{description}</p>
            <div class="project-card-meta">
                <span class="project-card-date">{date}</span>
                <div class="project-card-tags">
                    {
                        tags.map((tag) => (
                            <span class="project-card-tag">{tag}</span>
                        ))
                    }
                </div>
            </div>
        </div>
    </a>
</div>

<style>
    .project-card-outer {
        width: 100%;
        max-width: 340px;
        margin-inline: auto;
        margin-bottom: var(--spacing-md);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .project-card {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        background: var(--color-bg);
        border-radius: 0.75rem;
        box-shadow: 0 2px 12px var(--color-shadow);
        text-decoration: none;
        color: var(--color-text);
        transition:
            box-shadow 0.2s,
            scale 0.2s;
        cursor: pointer;
        overflow: hidden;
        width: 100%;
        padding-bottom: var(--spacing-xs);

        &:hover,
        &:focus {
            box-shadow: 0 8px 24px var(--color-shadow);
            scale: 1.01;
            position: relative;
            outline: none;
        }

        .project-card-cover {
            width: 100%;
            aspect-ratio: 16 / 9;
            object-fit: cover;
            display: block;
            border-radius: 0.75rem 0.75rem 0 0;
            box-shadow: 0 1px 4px var(--color-shadow, rgba(0, 0, 0, 0.06));
            border: none;
            margin: 0;
            max-height: 200px;
        }

        .project-card-content {
            width: 100%;
            padding: var(--spacing-sm);
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: var(--spacing-xs);

            .project-card-title {
                margin: 0 0 var(--spacing-xs) 0;
                font-size: var(--font-size-h5);
                font-weight: 700;
                color: var(--color-text);
                letter-spacing: 0.01em;
            }

            .project-card-desc {
                margin: 0 0 var(--spacing-xs) 0;
                color: var(--color-text-muted);
                font-size: var(--font-size-p);
                line-height: var(--line-height-base);
                text-align: left;
            }

            .project-card-meta {
                width: 100%;
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                gap: var(--spacing-xs);
                font-size: var(--font-size-xs);
                margin-top: var(--spacing-xs);

                .project-card-date {
                    color: var(--color-text-muted);
                    font-size: var(--font-size-xs, 0.93em);
                    font-style: italic;
                    margin-bottom: 2px;
                }

                .project-card-tags {
                    display: flex;
                    flex-wrap: wrap;
                    gap: var(--spacing-xs);

                    .project-card-tag {
                        background: var(--color-primary);
                        color: var(--color-text-muted);
                        border: 2px solid var(--color-border);
                        border-radius: 999px;
                        padding: 0.12em 0.8em;
                        font-size: var(--font-size-xs);
                        font-weight: 400;
                        letter-spacing: 0.01em;
                        white-space: nowrap;
                        margin-bottom: 2px;
                        box-shadow: none;
                    }
                }
            }
        }
    }

    @media (min-width: 1024px) {
        .project-card-outer {
            height: 100%;
            max-width: none;
            width: 100%;
            display: flex;
            flex-direction: column;
        }
        .project-card {
            height: 100%;
            display: flex;
            flex-direction: column;
            .project-card-cover {
                max-height: 400px;
            }
        }
    }
</style>
