---
import { formatProjectDate } from "@/content/project-utils";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type ProjectData = CollectionEntry<"projects">["data"];

interface ProjectCardProps {
  /** Project title */
  title: ProjectData["title"];
  /** Project description */
  description: ProjectData["description"];
  /** Project date (YYYY-MM) */
  date: ProjectData["date"];
  /** List of tags */
  tags: ProjectData["tags"];
  /** Cover image source */
  coverSrc: ProjectData["cover"];
  /** Link to project details */
  href: string;
}

type Props = ProjectCardProps;

const { title, description, date, tags, coverSrc, href } = Astro.props;
---

<a href={href} class="project-card" tabindex="0">
  {
    coverSrc && (
      <Image
        src={coverSrc}
        alt={title}
        class="project-card-cover"
        loading="lazy"
        decoding="async"
        format="webp"
        width="1200"
        height="675"
        sizes="(max-width: 1023px) 100vw, 500px"
      />
    )
  }
  <div class="project-card-content">
    <h2 class="project-card-title">{title}</h2>
    <p class="project-card-desc">{description}</p>
    <div class="project-card-meta">
      <span class="project-card-date">{formatProjectDate(date)}</span>
      <div class="project-card-tags">
        {tags.map((tag) => <span class="project-card-tag">{tag}</span>)}
      </div>
    </div>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface-3);
    border-radius: var(--card-radius);
    box-shadow: var(--elev-2);
    text-decoration: none;
    color: var(--color-text);
    transition:
      box-shadow var(--dur-2) var(--ease-standard),
      scale var(--dur-2) var(--ease-standard);
    cursor: pointer;
    overflow: hidden;
    padding-block-end: var(--space-2);
    border: var(--border-strong) solid var(--color-border);
  }

  .project-card:hover,
  .project-card:focus-visible {
    box-shadow: var(--elev-3);
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-card:hover,
    .project-card:focus-visible {
      scale: 1.012;
    }
  }

  .project-card-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-radius: var(--card-radius) var(--card-radius) 0 0;
    box-shadow: var(--elev-1);
    border: none;
    margin: 0;
    max-height: 500px;
  }

  .project-card-content {
    width: 100%;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .project-card-title {
    margin: 0;
    font-size: var(--heading-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    letter-spacing: 0.01em;
  }

  .project-card-desc {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: var(--lh);
    text-align: start;
  }

  .project-card-meta {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-small);
    margin-block-start: var(--space-2);
  }

  .project-card-date {
    color: var(--color-muted);
    font-style: italic;
    margin-block-end: var(--space-2);
  }

  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-card-tag {
    background: var(--grad-primary-soft);
    color: var(--color-on-primary);
    border-radius: 999px;
    padding: 0.12em 0.8em;
    font-weight: var(--fw-medium);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
</style>
