---
import { APP_VERSION } from "astro:env/server";
import { SERVER_STARTED_AT } from "@/server/config/runtime-info";
import PageSection from "@/components/ui/PageSection.astro";
import type { Translator } from "@/i18n/utils";

export interface Props {
  t: Translator;
}

const { t } = Astro.props;

/* APP_VERSION is the full git commit SHA in built images (see Dockerfile /
 * .github/workflows/cd.yml) and "dev" locally - only shorten the former. */
const isCommitSha = /^[0-9a-f]{40}$/i.test(APP_VERSION);
const displayedVersion = isCommitSha ? APP_VERSION.slice(0, 12) : APP_VERSION;

const rows = [
  { label: t("systemInfo.version"), value: displayedVersion, title: isCommitSha ? APP_VERSION : undefined },
  { label: t("systemInfo.environment"), value: import.meta.env.MODE },
  { label: t("systemInfo.serverStarted"), value: SERVER_STARTED_AT.toISOString() },
];
---

<PageSection title={t("systemInfo.pageTitle")} align="center">
  <dl class="system-info">
    {
      rows.map((row) => (
        <div class="system-info-row">
          <dt>{row.label}</dt>
          <dd title={row.title}>{row.value}</dd>
        </div>
      ))
    }
  </dl>
</PageSection>

<style>
  .system-info {
    inline-size: 100%;
    max-inline-size: 32rem;
    margin-block: 0;
    margin-inline: auto;
  }

  .system-info-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    padding-block: var(--space-sm);
    border-block-end: var(--border-hairline) solid var(--color-border-hairline);
  }

  .system-info-row:last-child {
    border-block-end: none;
  }

  .system-info-row dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .system-info-row dd {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }
</style>
