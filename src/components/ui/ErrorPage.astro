---
import { Icon } from "astro-icon/components";
import ActionButton from "@/components/ui/ActionButton.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

export type ErrorStatus = 404 | 500;

export interface Props {
  status: ErrorStatus;
}

const { status } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const content =
  status === 404
    ? {
        icon: "mdi:compass-off-outline",
        title: t("404.pageTitle"),
        message: t("404.pageText"),
        actionLabel: t("404.backHome"),
      }
    : {
        icon: "mdi:alert-circle-outline",
        title: t("500.pageTitle"),
        message: t("500.pageText"),
        actionLabel: t("500.backHome"),
      };
---

<section class="error-page container stack" data-status={status}>
  <span class="error-icon-badge">
    <Icon name={content.icon} aria-hidden="true" />
  </span>
  <p class="error-status" aria-hidden="true">{status}</p>
  <h1>{content.title}</h1>
  <p class="error-message">{content.message}</p>
  <ActionButton
    href={`/${lang}`}
    text={content.actionLabel}
    size="m"
    variant="primary"
  />
</section>

<style>
  .error-page {
    --flow: var(--space-sm);
    max-inline-size: 26.25rem;
    margin-block: 10vh 0;
    padding: var(--space-xl) var(--gutter);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--elev-2);
    text-align: center;
    color: var(--color-text);
    align-items: center;
  }

  .error-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    border-radius: 50%;
    background: var(--color-surface-high);
    color: var(--color-primary);
  }

  .error-page[data-status="500"] .error-icon-badge {
    background: var(--msg-error-bg);
    color: var(--msg-error-fg);
  }

  .error-icon-badge [data-icon] {
    inline-size: var(--icon-md);
    block-size: var(--icon-md);
  }

  .error-status {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .error-page h1 {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--text-3xl);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.01em;
  }

  .error-message {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-md);
    line-height: var(--lh);
  }
</style>
