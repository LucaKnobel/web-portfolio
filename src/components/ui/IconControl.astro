---
import "@/styles/buttons.css";
import type { HTMLAttributes } from "astro/types";

type Props = {
  label: string;
  variant?: "surface" | "ghost";
  class?: string;
} & (
  | ({ as?: "button" } & Omit<HTMLAttributes<"button">, "type" | "class" | "aria-label">)
  | ({ as: "summary" } & Omit<HTMLAttributes<"summary">, "class" | "aria-label">)
);

const { as: Tag = "button", label, variant = "surface", class: className, ...attributes } = Astro.props;
---

<Tag
  {...attributes}
  type={Tag === "button" ? "button" : undefined}
  class:list={["button", "icon-control", className]}
  data-variant={variant}
  aria-label={label}
>
  <slot />
</Tag>

<style>
  .icon-control {
    min-inline-size: var(--touch-target-min);
    min-block-size: var(--touch-target-min);
    padding: 0;
    background: var(--color-surface);
    list-style: none;
  }

  .icon-control::-webkit-details-marker {
    display: none;
  }

  .icon-control[data-variant="ghost"] {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  .icon-control[aria-expanded="true"] {
    background: var(--color-surface-high);
    border-color: var(--color-border-hairline);
    color: var(--color-link);
  }

  .icon-control:focus-visible {
    color: var(--color-link);
  }

  @media (hover: hover) {
    .icon-control:hover {
      background: var(--color-surface-high);
      border-color: var(--color-border-hairline);
      color: var(--color-link);
    }
  }

  .icon-control:active {
    background: var(--color-surface-higher);
  }
</style>
