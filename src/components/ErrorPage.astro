---
import ActionButton from "@/components/ActionButton.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

export type ErrorStatus = 404 | 500;

export interface ErrorPageProps {
  status: ErrorStatus;
}

const { status } = Astro.props as ErrorPageProps;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const content =
  status === 404
    ? {
        title: t("404.pageTitle"),
        message: t("404.pageText"),
        actionLabel: t("404.backHome"),
      }
    : {
        title: t("500.pageTitle"),
        message: t("500.pageText"),
        actionLabel: t("500.backHome"),
      };
---

<section class="error-page container stack">
  <h1>{content.title}</h1>
  <p>{content.message}</p>
  <ActionButton
    href={`/${lang}`}
    text={content.actionLabel}
    size="m"
    variant="primary"
  />
</section>

<style>
  .error-page {
    max-inline-size: 26.25rem;
    margin-block: 10vh 0;
    padding: var(--space-6) var(--gutter);
    background: var(--color-surface-1);
    border-radius: var(--card-radius);
    box-shadow: var(--elev-2);
    text-align: center;
    color: var(--color-text);
    align-items: center;
  }

  .error-page h1 {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--heading-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.01em;
  }

  .error-page p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: var(--lh);
  }

</style>
