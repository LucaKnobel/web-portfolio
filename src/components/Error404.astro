---
import ErrorPage from "@/components/ErrorPage.astro";

export interface Error404Props {
    /** Translation function for UI strings */
    t: Function;
}
const { t } = Astro.props as Error404Props;
---
<ErrorPage
    title={t("404.pageTitle")}
    message={t("404.pageText")}
    actionLabel={t("404.backHome")}
    />