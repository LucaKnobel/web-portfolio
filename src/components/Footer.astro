---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import Navigation from "./Navigation.astro";
import ActionButton from "./ActionButton.astro";

const currentYear = new Date().getFullYear();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const footerLinks = [
    { href: `/${lang}/projects`, label: t("nav.projects") },
    { href: `/${lang}/contact`, label: t("nav.contact") },
    { href: `/${lang}/career`, label: t("nav.career") },
    { href: `/${lang}/imprint`, label: t("nav.imprint") },
    { href: `/${lang}/privacy-policy`, label: t("nav.privacyPolicy") },
];
---

<footer class="footer">
    <div class="container">
        <Navigation links={footerLinks} />

        <div class="socials">
            <ActionButton  href="https://github.com/LucaKnobel" icon="mdi:github" ariaLabel="GitHub" size="md" variant="gradient" />
            <ActionButton href="https://linkedin.com/in/luca-knobel-14b4a7221" icon="mdi:linkedin" ariaLabel="LinkedIn" size="md" variant="gradient" />
        </div>
        <div class="copyright">
            <p>&copy; {currentYear} {t("footer.copyright")}</p>
        </div>
    </div>
</footer>

<style>
    .footer {
        margin-top: auto;
        left: 0;
        width: 100%;
        background: var(--color-secondary);
        text-align: center;
        padding: var(--spacing-md);
        border: solid var(--color-border) 1px;

        .container {
            display: flex;
            align-items: center;
            flex-direction: column;
            justify-content: center;
            gap: var(--spacing-sm);

            .nav-links {
                display: flex;
                align-items: center;
                flex-direction: column;
                justify-content: center;
                gap: var(--spacing-sm);
                text-decoration: underline 1px;
                color: var(--color-links);
            }
            .copyright p {
                display: flex;
                justify-content: center;
                align-items: center;
                width: 100%;
                margin: 0;
            }
            .socials {
                display: flex;
                align-items: center;
                flex-direction: row;
                justify-content: center;
                gap: var(--spacing-sm);

                .footer-btn {
                    border: none;
                    padding: 0;
                }
            }
        }
    }
    @media (min-width: 1024px) {
        .footer {
            padding: var(--spacing-xs);
            .container {
                .nav-links {
                    flex-direction: row;
                    a:hover {
                        scale: 1.05;
                    }
                }
            }
        }
    }
</style>
