---
import { useTranslation } from "@/i18n";
import "@/styles/tokens.css";
import "@/styles/base.css";
import { Icon } from "astro-icon/components";
const t = useTranslation(Astro.currentLocale ?? "en");
const currentYear = new Date().getFullYear();
---

<footer class="footer">
    <div class="container">
        <div class="nav-links">
            <a href={`/${Astro.currentLocale}/projects`}>{t.nav.projects}</a>
            <a href={`/${Astro.currentLocale}/career`}>{t.nav.career}</a>
            <a href={`/${Astro.currentLocale}/contact`}>{t.nav.contact}</a>
            <a href={`/${Astro.currentLocale}/imprint`}>{t.nav.imprint}</a>
            <a href={`/${Astro.currentLocale}/privacy-policy`}
                >{t.nav.privacyPolicy}</a
            >
        </div>
        
        <div class="socials">
            <a
                class="social-btn"
                href="https://github.com/LucaKnobel"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
            >
                <Icon name="mdi:github" class="social-icon" />
            </a>
            <a
                class="social-btn"
                href="https://linkedin.com/in/luca-knobel-14b4a7221"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
            >
                <Icon name="mdi:linkedin" class="social-icon" />
            </a>
        </div>
        <div class="copyright">
            <p>&copy; {currentYear} {t.footer.copyright}</p>
        </div>
    </div>
</footer>

<style>
    .footer {
        margin-top: auto;
        left: 0;
        width: 100%;
        background: var(--color-secondary);
        text-align: center;
        padding: var(--spacing-md);
        border: solid var(--color-border) 1px;
        

        .container {
            display: flex;
            align-items: center;
            flex-direction: column;
            justify-content: center;
            gap: var(--spacing-sm);

            .nav-links {
                display: flex;
                align-items: center;
                flex-direction: column;
                justify-content: center;
                gap: var(--spacing-sm);
                text-decoration: underline 1px;
                color: var(--color-links);
            }
            .copyright p {
                display: flex;
                justify-content: center;
                align-items: center;
                width: 100%;
                margin: 0;
            }
            .socials {
                display: flex;
                align-items: center;
                flex-direction: row;
                justify-content: center;
                gap: var(--spacing-sm);
        
                .social-btn {
                    border: solid var(--color-border) 1px;
                    border-radius: var(--btn-radius);
                    width: 45px;
                    height: 45px;
                    cursor: pointer;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    background-color: transparent;
                    color: var(--color-btn-bg);
                }
                .social-icon {
                    width: 28px;
                    height: 28px;
                    flex-shrink: 0;
                }
            }
        }

    }
    @media (min-width: 1024px) {
            .footer {
                padding: var(--spacing-xs);
                .container {
                    .nav-links {
                        flex-direction: row;
                        a:hover {
                            scale: 1.05;
                        }
                    }
                }
            }
        }
</style>
