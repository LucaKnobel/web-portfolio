---
import { Icon } from "astro-icon/components";
import IconControl from "@/components/ui/IconControl.astro";
import { languages as languageConfig } from "@/i18n/ui";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const pathWithoutLanguage = Astro.url.pathname.replace(
  /^\/[a-z]{2}(?=\/|$)/,
  "",
);

const languageLinks = Object.entries(languageConfig).map(([code, label]) => ({
  code,
  label,
  href: `/${code}${pathWithoutLanguage}`,
}));
---

<details class="language-select" data-language-select>
  <IconControl
    as="summary"
    class="language-toggle"
    variant="ghost"
    label={t("aria.languageSelect")}
    aria-expanded="false"
  >
    <span class="language-code" aria-hidden="true">{currentLang.toUpperCase()}</span>
    <Icon name="mdi:chevron-down" class="language-chevron" aria-hidden="true" />
  </IconControl>

  <nav class="dropdown" aria-label={t("aria.languageSelect")}>
    {
      languageLinks.map((language) => (
        <a
          href={language.href}
          class="language-option"
          lang={language.code}
          hreflang={language.code}
          aria-current={language.code === currentLang ? "page" : undefined}
        >
          <span class="label">{language.label}</span>
        </a>
      ))
    }
  </nav>
</details>

<script>
  const cleanups = new Set<() => void>();

  const enhanceLanguageSelects = () => {
    document
      .querySelectorAll<HTMLDetailsElement>("[data-language-select]")
      .forEach((select) => {
        if (select.dataset.enhanced) return;

        const summary = select.querySelector("summary");
        if (!summary) return;

        const syncExpandedState = () => {
          summary.setAttribute("aria-expanded", String(select.open));
        };

        const closeOnOutsideClick = (event: MouseEvent) => {
          if (!select.contains(event.target as Node)) select.open = false;
        };

        select.dataset.enhanced = "true";
        select.addEventListener("toggle", syncExpandedState);
        document.addEventListener("click", closeOnOutsideClick);
        syncExpandedState();

        cleanups.add(() => {
          select.removeEventListener("toggle", syncExpandedState);
          document.removeEventListener("click", closeOnOutsideClick);
          delete select.dataset.enhanced;
        });
      });
  };

  const cleanupLanguageSelects = () => {
    cleanups.forEach((cleanup) => cleanup());
    cleanups.clear();
  };

  enhanceLanguageSelects();
  document.addEventListener("astro:page-load", enhanceLanguageSelects);
  document.addEventListener("astro:before-swap", cleanupLanguageSelects);
</script>

<style>
  .language-select {
    position: relative;
    display: inline-block;
  }

  .language-toggle {
    gap: var(--space-2xs);
  }

  .language-code {
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.02em;
  }

  .language-chevron {
    width: 14px;
    height: 14px;
    transition: transform var(--duration-normal) var(--ease-standard);
  }

  .language-toggle[aria-expanded="true"] .language-chevron {
    transform: rotate(180deg);
  }

  .dropdown {
    position: absolute;
    top: calc(100% + var(--space-xs));
    left: 50%;
    transform: translateX(-50%);
    min-width: 120px;
    margin: 0;
    padding: 0;
    background: var(--color-surface-high);
    border: var(--border-hairline) solid var(--color-border-hairline);
    border-radius: var(--radius-md);
    box-shadow: var(--elev-3);
    overflow: hidden;
    z-index: var(--layer-tooltip);
    max-height: 50vh;
    overflow-y: auto;
  }

  .language-option {
    /* Keep the global ring inside the clipped dropdown. */
    --focus-ring-offset: calc(-1 * var(--focus-ring-width));
    width: 100%;
    box-sizing: border-box;
    background: transparent;
    border: 0;
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm);
    text-decoration: none;
    transition:
      background-color var(--duration-normal) var(--ease-standard),
      color var(--duration-normal) var(--ease-standard);
  }

  .language-option:hover,
  .language-option[aria-current="page"] {
    background: var(--color-surface-higher);
    color: var(--color-primary);
  }

  .label {
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
  }

  .language-option[aria-current="page"] .label {
    font-weight: var(--fw-semibold);
  }

</style>
