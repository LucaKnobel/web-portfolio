---
import Navigation from "@/components/layout/Navigation.astro";
import ActionButton from "@/components/ui/ActionButton.astro";
import Copyright from "@/components/layout/Copyright.astro";
import type { Language, Translator } from "@/i18n/utils";

export interface Props {
  /** Language code for constructing localized links */
  lang: Language;
  /** Translation function for UI strings */
  t: Translator;
}

const { lang, t } = Astro.props;

const footerLinks = [
  { href: `/${lang}/projects`, label: t("nav.projects") },
  { href: `/${lang}/contact`, label: t("nav.contact") },
  { href: `/${lang}/career`, label: t("nav.career") },
  { href: `/${lang}/imprint`, label: t("nav.imprint") },
  { href: `/${lang}/privacy-policy`, label: t("nav.privacyPolicy") },
  { href: `/${lang}/system-info`, label: t("nav.systemInfo") },
];
---

<footer class="footer">
  <div class="footer-content container stack">
    <Navigation links={footerLinks} />
    <div class="socials cluster">
      <ActionButton
        href="https://github.com/LucaKnobel"
        icon="mdi:github"
        ariaLabel="GitHub"
        variant="secondary"
        size="square"
      />
      <ActionButton
        href="https://linkedin.com/in/luca-knobel-14b4a7221"
        icon="mdi:linkedin"
        ariaLabel="LinkedIn"
        variant="secondary"
        size="square"
      />
    </div>
    <Copyright t={t} />
  </div>
</footer>

<style>
  .footer {
    margin-block-start: auto;
    padding-block: var(--space-lg);
    background: var(--color-surface);
    border-block-start: var(--border-hairline) solid var(--color-border-hairline);
    text-align: center;
  }

  .footer-content {
    align-items: center;
  }

  .socials {
    gap: var(--space-sm);
    justify-content: center;
  }
</style>
