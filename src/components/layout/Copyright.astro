---
import type { Translator } from "@/i18n/utils";

export interface Props {
  /** Translation function for UI strings */
  t: Translator;
  /** Name/entity for copyright (optional - uses translation if not provided) */
  name?: string;
}

const { t, name } = Astro.props;

/* Use provided name or fallback to translation */
const displayName = name || t("footer.copyright");
---

<div class="copyright">
  <p class="copyright-text">
    &copy; {new Date().getFullYear()}
    {displayName}
  </p>
</div>

<style>
  .copyright {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .copyright-text {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
    padding: var(--space-xs) 0;
    transition: color var(--duration-normal) var(--ease-standard);
  }
</style>
