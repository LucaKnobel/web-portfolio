---
import ProjectCard from "@/components/ProjectCard.astro";
import { getCollection } from "astro:content";
import type { Language, Translator } from "@/i18n/utils";

export interface ProjectSectionProps {
  /** Current language (e.g., 'de' or 'en') */
  lang: Language;
  /** Translation function for UI strings */
  t: Translator;
}
const { lang, t } = Astro.props as ProjectSectionProps;

let projects = [];
try {
  const allProjects = await getCollection("projects");
  const languageProjects = allProjects.filter(
    (project) => project.data.lang === lang,
  );
  projects = languageProjects.sort((a, b) => {
    const dateA = new Date(a.data.date);
    const dateB = new Date(b.data.date);
    return dateB.getTime() - dateA.getTime();
  });
} catch (err) {
  throw err;
}
---

<section class="project-list-section">
  <h1 class="project-title">{t("projects.pageTitle")}</h1>
  <div class="project-card-wrapper">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          date={project.data.date}
          tags={project.data.tags}
          coverSrc={project.data.cover}
          href={`/${lang}/projects/${project.id.replace(`${lang}/`, "")}`}
        />
      ))
    }
  </div>
</section>

<style>
  .project-list-section {
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-12) var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);

    .project-title {
      font-size: var(--heading-md);
      font-weight: var(--fw-semibold);
      margin: 0 0 var(--space-12) 0;
      color: var(--color-text);
      text-wrap: balance;
      text-align: center;
      width: 100%;
    }

    .project-card-wrapper {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      width: 100%;
    }
  }

  @media (min-width: 1024px) {
    .project-list-section {
      padding: var(--space-16) var(--gutter);
      .project-title {
        font-size: var(--heading-lg);
      }
      .project-card-wrapper {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 500px));
        justify-content: center;
        gap: var(--space-6);
        grid-auto-rows: 1fr;
      }
    }
  }
</style>
