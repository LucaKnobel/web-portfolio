---
import { compareProjectsByDate } from "@/content/project-utils";
import ProjectCard from "@/components/ProjectCard.astro";
import PageSection from "@/components/PageSection.astro";
import { getCollection } from "astro:content";
import type { Language, Translator } from "@/i18n/utils";

export interface ProjectSectionProps {
  /** Current language (e.g., 'de' or 'en') */
  lang: Language;
  /** Translation function for UI strings */
  t: Translator;
}
const { lang, t } = Astro.props as ProjectSectionProps;

let projects;
const allProjects = await getCollection("projects");
const languageProjects = allProjects.filter(
  (project) => project.data.lang === lang,
);
projects = languageProjects.sort(compareProjectsByDate);

---

<div class="projects-page">
<PageSection title={t("projects.pageTitle")} align="center">
  <div class="project-card-wrapper">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          date={project.data.date}
          tags={project.data.tags}
          coverSrc={project.data.cover}
          href={`/${lang}/projects/${project.id.replace(`${lang}/`, "")}`}
        />
      ))
    }
  </div>
</PageSection>
</div>

<style>
  .projects-page {
    padding-block: var(--space-6) var(--space-12);
  }

  .project-card-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(25rem, 100%), 1fr));
    gap: var(--space-8);
  }
</style>
