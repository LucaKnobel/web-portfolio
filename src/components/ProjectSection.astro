---
import ProjectCard from "@/components/ProjectCard.astro";
import PageSection from "@/components/PageSection.astro";
import type { CollectionEntry } from "astro:content";
import type { Language, Translator } from "@/i18n/utils";

interface Props {
  lang: Language;
  t: Translator;
  projects: CollectionEntry<"projects">[];
}

const { lang, t, projects } = Astro.props;

---

<div class="projects-page">
<PageSection title={t("projects.pageTitle")} align="center">
  <div class="project-card-wrapper">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          date={project.data.date}
          tags={project.data.tags}
          coverSrc={project.data.cover}
          href={`/${lang}/projects/${project.id.replace(`${lang}/`, "")}`}
        />
      ))
    }
  </div>
</PageSection>
</div>

<style>
  .projects-page {
    padding-block: var(--space-6) var(--space-12);
  }

  .project-card-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(25rem, 100%), 1fr));
    gap: var(--space-8);
  }
</style>
