---
import { formatProjectDate } from "@/content/project-utils";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type ProjectData = CollectionEntry<"projects">["data"];

interface Props {
  /** Project title */
  title: ProjectData["title"];
  /** Project description */
  description: ProjectData["description"];
  /** Project date (YYYY-MM) */
  date: ProjectData["date"];
  /** List of tags */
  tags: ProjectData["tags"];
  /** Cover image source */
  coverSrc: ProjectData["cover"];
  /** Link to project details */
  href: string;
}

const { title, description, date, tags, coverSrc, href } = Astro.props;
---

<a href={href} class="project-card">
  {
    coverSrc && (
      <Image
        src={coverSrc}
        alt={title}
        class="project-card-cover"
        loading="lazy"
        decoding="async"
        format="webp"
        width="1200"
        height="675"
        sizes="(max-width: 1023px) 100vw, 500px"
      />
    )
  }
  <div class="project-card-content">
    <h2 class="project-card-title">{title}</h2>
    <p class="project-card-desc">{description}</p>
    <div class="project-card-meta">
      <time class="project-card-date" datetime={date}
        >{formatProjectDate(date)}</time
      >
      <div class="project-card-tags">
        {tags.map((tag) => <span class="project-card-tag">{tag}</span>)}
      </div>
    </div>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--elev-1);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color var(--duration-fast) var(--ease-standard);
    cursor: pointer;
    overflow: hidden;
    border: var(--border-hairline) solid var(--color-border-hairline);
  }

  .project-card:focus-visible {
    border-color: var(--color-link);
  }

  @media (hover: hover) {
    .project-card:hover {
      border-color: var(--color-link);
    }
  }

  .project-card-cover {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-block-end: var(--border-hairline) solid var(--color-border-hairline);
    margin: 0;
  }

  .project-card-content {
    inline-size: 100%;
    flex: 1;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    overflow-wrap: anywhere;
  }

  .project-card-title {
    margin: 0;
    font-size: 1.375rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    letter-spacing: 0;
  }

  .project-card-desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-md);
    line-height: var(--lh);
    text-align: start;
  }

  .project-card-meta {
    inline-size: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    margin-block-start: auto;
    padding-block-start: var(--space-lg);
  }

  .project-card-date {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .project-card-tag {
    background: color-mix(
      in srgb,
      var(--color-link) 8%,
      var(--color-surface)
    );
    color: color-mix(in srgb, var(--color-link) 65%, var(--color-text));
    border: var(--border-hairline) solid
      color-mix(in srgb, var(--color-link) 20%, var(--color-border-hairline));
    border-radius: var(--radius-md);
    padding: var(--space-2xs) var(--space-sm);
    font-size: var(--text-xs);
    font-weight: var(--fw-medium);
    letter-spacing: 0;
    max-inline-size: 100%;
  }
</style>
