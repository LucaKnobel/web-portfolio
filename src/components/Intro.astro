---
import portrait from "@/assets/portrait-photo.jpg";
import { Image } from "astro:assets";
import type { Translator } from "@/i18n/utils";

export interface IntroProps {
  /** Translation function for UI strings */
  t: Translator;
  /** Name to display in the hero */
  name?: string;
  /** Role or job title */
  role?: string;
  /** Portrait image source */
  portraitSrc?: ImageMetadata;
  /** GitHub profile URL */
  githubUrl?: string;
  /** LinkedIn profile URL */
  linkedinUrl?: string;
}

const {
  t,
  name = "Luca Knobel",
  role = "Software Engineer",
  portraitSrc = portrait,
  githubUrl = "https://github.com/LucaKnobel",
  linkedinUrl = "https://linkedin.com/in/luca-knobel-14b4a7221",
} = Astro.props as IntroProps;
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero-grid container">
    <div class="hero-heading">
      <h1 id="hero-name" class="hero-name">{name}</h1>
      <p class="hero-role">{role}</p>
    </div>

    <Image
      src={portraitSrc}
      alt={t("intro.portraitAlt") + " " + name}
      class="hero-portrait"
      loading="eager"
      decoding="async"
      quality={90}
      format="webp"
      priority
      sizes="(min-width: 1024px) 18rem, 48vw"
    />

    <p class="hero-positioning">{t("intro.positioning")}</p>

    <div class="hero-links cluster">
      <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-block-size: calc(100dvh - var(--header-height));
    padding-block: clamp(2rem, 6dvh, 4rem);
    display: flex;
    align-items: center;
  }

  /* Mobile / tablet: the portrait sits in its own row above the name, so it
     can be a proper, clearly visible size without competing with the
     heading for horizontal space. */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "portrait"
      "heading"
      "positioning"
      "links";
    row-gap: var(--space-5);
  }

  .hero-heading {
    grid-area: heading;
    display: flex;
    flex-direction: column;
  }

  .hero-name {
    margin: 0;
    font-size: var(--display-xl);
    font-weight: var(--fw-semibold);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .hero-role {
    margin-block: var(--space-2) 0;
    font-size: var(--heading-xs);
    font-weight: var(--fw-medium);
    color: var(--color-muted);
  }

  .hero-positioning {
    grid-area: positioning;
    margin: 0;
    max-width: 52ch;
    text-align: left;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.7;
    color: var(--color-text);
  }

  .hero-links {
    grid-area: links;
    justify-content: flex-start;
    gap: var(--space-6);
    font-weight: var(--fw-medium);
  }

  .hero-links a {
    color: var(--color-link);
    text-decoration: none;
    padding: var(--space-1);
  }

  .hero-links a:hover,
  .hero-links a:focus-visible {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  .hero-portrait {
    grid-area: portrait;
    justify-self: start;
    margin-block-end: var(--space-1);
    width: clamp(11rem, 48vw, 15rem);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    border: none;
    box-shadow: none;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 38rem) auto;
      grid-template-areas:
        "heading      portrait"
        "positioning  portrait"
        "links        portrait";
      column-gap: clamp(3rem, 7vw, 6rem);
      row-gap: var(--space-6);
      align-items: center;
    }

    .hero-portrait {
      align-self: center;
      width: clamp(15rem, 20vw, 18rem);
    }
  }
</style>
