---
import type { Translator } from "@/i18n/utils";

export interface CareerCardProps {
  /** Translation function for UI strings */
  t: Translator;
  /** Entry object containing all career/education data */
  entry: {
    /** Name of the organization */
    organizationName: string;
    /** Website of the organization */
    organizationWebsite: string;
    /** Job or education title */
    title: string;
    /** Employment rate (e.g., full-time, part-time) */
    employmentRate?: string;
    /** List of responsibilities */
    responsibilities?: string[];
    /** Study mode (e.g., on-site, remote) */
    studyMode?: string;
    /** Final grade (string or number) */
    finalGrade?: string | number;
    /** Period of employment or study */
    period: {
      /** Start date */
      start: string;
      /** End date */
      end: string;
    };
    /** List of key skills */
    keySkills: string[];
  };
}

const { t, entry } = Astro.props as CareerCardProps;

const {
  organizationName,
  organizationWebsite,
  title,
  employmentRate,
  studyMode,
  finalGrade,
  period,
  responsibilities,
  keySkills,
} = entry;
---

<article class="card-base">
  <header>
    <h4>{title}</h4>
    <a href={organizationWebsite} target="_blank" rel="noopener noreferrer"
      >{organizationName}</a
    >
    <div class="meta">
      <div class="meta-row">
        {employmentRate && <span>{employmentRate}</span>}
        {studyMode && <span>{studyMode}</span>}
        <span>{period.start} – {period.end}</span>
      </div>
      {
        finalGrade && (
          <span class="final-grade">
            {t("career.finalGrade")}: {finalGrade}
          </span>
        )
      }
    </div>
  </header>
  <details>
    <summary>{t("career.detailsSummary")}</summary>
    <section class="details-content">
      {
        responsibilities && responsibilities.length > 0 && (
          <>
            <strong>{t("career.responsibilities")}:</strong>
            <ul>
              {responsibilities.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </>
        )
      }
      <strong>{t("career.keySkills")}:</strong>
      <ul>
        {keySkills.map((skill) => <li>{skill}</li>)}
      </ul>
    </section>
  </details>
</article>

<style>
  .card-base {
    background: var(--color-surface-1);
    border-radius: var(--card-radius);
    box-shadow: var(--elev-1);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-inline-size: 0;
  }

  .card-base header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .card-base h4 {
    font-size: var(--heading-sm);
    font-weight: var(--fw-medium);
    margin: 0;
    color: var(--color-text);
  }

  .card-base header a {
    color: var(--color-link);
    text-decoration: none;
    font-size: var(--text-body);
    transition: color var(--dur-1) var(--ease-standard);
  }

  .card-base header a:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .meta-row {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .final-grade {
    display: block;
    margin-block-start: 2px;
    color: var(--color-primary);
    font-weight: var(--fw-medium);
  }

  .card-base details {
    margin-block-start: var(--space-2);
    border-block-start: 1px solid var(--color-border-hairline);
    padding-block-start: var(--space-2);
  }

  .card-base summary {
    cursor: pointer;
    font-size: var(--text-small);
    color: var(--color-primary);
    padding-block: var(--space-2);
    font-weight: var(--fw-medium);
    border-radius: var(--radius-sm);
    transition: background var(--dur-1) var(--ease-standard);
  }

  .card-base summary:focus,
  .card-base summary:hover {
    background: var(--color-surface-2);
    color: var(--color-primary-hover);
  }

  .details-content {
    margin-block-start: var(--space-2);
    font-size: var(--text-body);
    color: var(--color-text);
  }

  .details-content ul {
    margin: 0 0 var(--space-2);
    padding-inline-start: 1.2em;
    list-style: disc;
  }

  .details-content strong {
    font-weight: var(--fw-medium);
    color: var(--color-primary);
  }
</style>
