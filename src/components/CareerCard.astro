---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface CareerEntry {
  organizationName: string;
  organizationWebsite: string;
  title: string;
  employmentRate: string;
  period: {
    start: string;
    end: string;
  };
  responsibilities: string[];
  keySkills: string[];
}

const {
    organizationName,
    organizationWebsite,
    title,
    employmentRate,
    period,
    responsibilities,
    keySkills,
} = Astro.props as CareerEntry;
---

<article class="card-base">
  <header>
    <h4>{title}</h4>
    <a href={organizationWebsite} target="_blank" rel="noopener"
        >{organizationName}</a
    >
    <div class="meta">
      <span>{employmentRate}</span>
      <span>{period.start} – {period.end}</span>
    </div>
  </header>
  <details>
    <summary>{t("career.detailsSummary")}</summary>
    <section class="details-content">
      <strong>{t("career.responsibilities")}:</strong>
      <ul>
        {responsibilities.map((item) => <li>{item}</li>)}
      </ul>
      <strong>{t("career.keySkills")}:</strong>
      <ul>
        {keySkills.map((skill) => <li>{skill}</li>)}
      </ul>
    </section>
  </details>
</article>
