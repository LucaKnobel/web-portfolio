import PrivacyPolicySection from "@/components/PrivacyPolicySection.astro";

import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<BaseLayout title="Luca Knobel | Portfolio">
    <PrivacyPolicySection lang={lang} t={t} />
</BaseLayout>

