---
import { getProjectDetail } from "@/content/get-project-detail.ts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import ProjectDetail from "@/components/ProjectDetail.astro";

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);

if (!lang || !slug) {
  return Astro.redirect("/404");
}

const t = useTranslations(lang);

let detail;
try {
  detail = await getProjectDetail(lang, slug);
} catch (err) {
  return Astro.redirect("/500");
}

if (!detail || !detail.project || !detail.Content) {
  return Astro.redirect("/404");
}

const { project, Content } = detail;
---

<BaseLayout title={`Luca Knobel | ${project.data.title}`}>
  <ProjectDetail project={project} lang={lang} t={t} Content={Content} />
</BaseLayout>
