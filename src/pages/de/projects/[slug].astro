---
import "@/styles/base.css";
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Finde das Projekt anhand der slug
const allProjects = await getCollection("projects");
const project = allProjects.find((p) => p.id === slug);

// 404 wenn Projekt nicht existiert
if (!project) {
    return Astro.redirect("/404");
}

// Nur Projekte der aktuellen Sprache anzeigen
if (project.data.lang !== lang) {
    return Astro.redirect(`/${lang}/projects`);
}

// RICHTIG: render() function für Markdown zu HTML
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | Luca Knobel`}>
    <article class="project-detail">
        <header class="project-header">
            <div class="project-meta">
                <a href={`/${lang}/projects`} class="back-link">
                    ← {t("nav.projects")}
                </a>
                <span class="project-date">{project.data.date}</span>
            </div>

            <h1 class="project-title">{project.data.title}</h1>
            <p class="project-description">{project.data.description}</p>

            {
                project.data.url && (
                    <a
                        href={project.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="project-link"
                    >
                        GitHub Repository
                    </a>
                )
            }
        </header>

        <div class="project-content">
            <Content />
        </div>
    </article>
</BaseLayout>

<style>
    .project-detail {
        max-width: 100%;
        margin: var(--spacing-md) auto;
        padding: var(--spacing-sm);
        line-height: var(--line-height-base);
       

        .project-header {
            padding: var(--spacing-sm);
            border: solid 1px var(--color-border);
            border-radius: 1rem;

            .project-meta {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: var(--spacing-md);
                flex-wrap: wrap;
                gap: var(--spacing-xs);

                .back-link {
                    color: var(--color-link);
                    text-decoration: none;
                    font-size: var(--font-size-p);
                    font-weight: 500;
                    transition: color 0.2s ease;

                    &:hover {
                        color: var(--color-link-hover);
                        text-decoration: underline;
                    }
                }

                .project-date {
                    color: var(--color-text-muted);
                    font-size: var(--font-size-p);
                    font-style: italic;
                    white-space: nowrap;
                }
            }

            .project-title {
                font-size: var(--font-size-h2);
                margin: 0 0 var(--spacing-sm) 0;
                word-wrap: break-word;
                hyphens: auto;
            }

            .project-description {
                color: var(--color-text-muted);
                margin: 0 0 var(--spacing-md) 0;
                line-height: var(--line-height-base);
                text-align: left;
            }

            .project-link {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                background: var(--btn-bg);
                color: var(--btn-text);
                padding: var(--spacing-xs) var(--spacing-sm);
                border-radius: 0.5rem;
                text-decoration: none;
                font-weight: 600;
                font-size: var(--font-size-p);
                transition: all 0.2s ease;
                border: none;
                box-shadow: 0 4px 20px var(--color-shadow);
                
                &:hover {
                    background: var(--btn-hover-bg);
                }
            }
        }

        /* Content Area */
        .project-content {
            margin-top: var(--spacing-md);
            word-wrap: break-word;
            hyphens: auto; 

            /* Markdown Content Styling */
            h1,
            h2,
            h3,
            h4,
            h5,
            h6 {
                
                font-weight: 600;
                line-height: var(--line-height-tight);
                scroll-margin-top: var(--spacing-lg);
                word-wrap: break-word;
                hyphens: auto;

                &:first-child {
                    margin-top: 0;
                }
            }

            & h1 {
                padding-bottom: 0.5rem;
                border-bottom: 2px solid var(--color-border);
                margin-top: var(--spacing-lg);
                margin-bottom: var(--spacing-lg);
              
            }

            & h2 {
                font-size: var(--font-size-h3);
                margin-top: var(--spacing-md);
                margin-bottom: var(--spacing-md);

            }

            & h3 {
                font-size: var(--font-size-h4);
                margin-top: var(--spacing-sm);
                margin-bottom: var(--spacing-sm);
            }

            & p {
                margin-bottom: var(--spacing-sm);
                line-height: var(--line-height-base);
                text-align: left;
                word-wrap: break-word;
                hyphens: auto;
            }

            & ul,
            & ol {
                margin: var(--spacing-sm) 0;
                padding-left: var(--spacing-md);

                & li {
                    margin-bottom: 0.5rem;
                    line-height: var(--line-height-base);
                    word-wrap: break-word;

                    & p {
                        margin-bottom: 0.25rem;
                    }
                }
            }

            & a {
                color: var(--color-link);
                text-decoration: underline;
                text-decoration-color: transparent;
                transition: text-decoration-color 0.2s ease;
                word-wrap: break-word;

                &:hover {
                    text-decoration-color: var(--color-link);
                }
            }

            /* Images - Mobile optimiert */
            & img {
                max-width: 100%;
                width: 100%;
                height: auto;
                border-radius: 0.5rem;
                margin: var(--spacing-sm) auto;
                display: block;
                box-shadow: 0 2px 8px var(--color-shadow);
                background: var(--color-secondary);
                object-fit: contain;

                &:hover {
                    transform: scale(1.01);
                    transition: transform 0.3s ease;
                }
            }

            /* Inline Code - KEIN Umbruch, clean bleiben */
            & code {
                background: var(--color-secondary);
                color: var(--color-text);
                padding: 0.2em 0.4em;
                border-radius: 0.25rem;
                font-size: 0.85em;
                font-family: "Monaco", "Menlo", "Ubuntu Mono", monospace;
                border: 1px solid var(--color-border);
                white-space: nowrap;
                display: inline;
            }

            /* Code-Blöcke - Horizontal scrollbar für Mobile */
            & pre {
                background: var(--color-secondary);
                border: 1px solid var(--color-border);
                border-radius: 0.5rem;
                padding: var(--spacing-xs);
                margin: var(--spacing-sm) 0;
                overflow-x: auto;
                font-size: 0.8rem;
                line-height: 1.4;
                white-space: pre;

                & code {
                    background: transparent;
                    border: none;
                    padding: 0;
                    font-size: inherit;
                    white-space: pre;
                    display: block;
                    word-break: normal;
                }
            }

            /* Tabellen - Mobile First aber richtige Tabellen */
            & table {
                width: 100%;
                border-collapse: collapse;
                margin: var(--spacing-sm) 0;
                font-size: 0.75rem;
                background: var(--color-bg);
                border-radius: 0.5rem;
                overflow: hidden;
                box-shadow: 0 2px 8px var(--color-shadow);
                table-layout: auto;

                & thead {
                    display: table-header-group;
                }

                & tbody {
                    display: table-row-group;
                }

                & tr {
                    display: table-row;

                    &:hover {
                        background: var(--color-primary);
                    }
                }

                & th {
                    display: table-cell;
                    background: var(--color-secondary);
                    font-weight: 600;
                    color: var(--color-text);
                    padding: 0.375rem 0.5rem;
                    border-bottom: 1px solid var(--color-border);
                    text-align: left;
                    vertical-align: top;
                    font-size: 0.75rem;
                    word-wrap: break-word;
                    hyphens: auto;
                    white-space: normal;
                    width: auto;
                }

                & td {
                    display: table-cell;
                    padding: 0.375rem 0.5rem;
                    border-bottom: 1px solid var(--color-border);
                    text-align: left;
                    vertical-align: top;
                    word-wrap: break-word;
                    hyphens: auto;
                    white-space: normal;
                    line-height: 1.3;
                    width: auto;
                }
            }

            & blockquote {
                border-left: 3px solid var(--color-link);
                padding: var(--spacing-xs);
                margin: var(--spacing-sm) 0;
                font-style: italic;
                color: var(--color-text-muted);
                background: var(--color-secondary);
                border-radius: 0 0.375rem 0.375rem 0;
                font-size: 0.9rem;
            }

            & hr {
                border: none;
                height: 1px;
                background: var(--color-border);
                margin: var(--spacing-md) 0;
            }
        }

        /* Desktop Breakpoint: 1024px+ */
        @media (min-width: 1024px) {
            max-width: 900px;
            padding: var(--spacing-lg);

            .project-header {
                margin-bottom: var(--spacing-xl);

                .project-meta {
                    margin-bottom: var(--spacing-lg);

                    .back-link {
                        font-size: var(--font-size-h6);
                    }

                    .project-date {
                        font-size: var(--font-size-h6);
                    }
                }

                .project-title {
                    font-size: var(--font-size-h1);
                    margin-bottom: var(--spacing-md);
                }

                .project-description {
                    font-size: var(--font-size-h6);
                    margin-bottom: var(--spacing-lg);
                    max-width: 80%;
                }

                .project-link {
                    font-size: var(--font-size-h6);
                    padding: var(--spacing-sm) var(--spacing-md);
                }
            }

            .project-content {
                margin-top: var(--spacing-xxl);

                & h1 {
                    font-size: var(--font-size-h1);
                    margin-bottom: var(--spacing-lg);
                }

                & h2 {
                    font-size: var(--font-size-h2);
                    margin-top: var(--spacing-xxl);
                }

                & h3 {
                    font-size: var(--font-size-h3);
                }

                & p {
                    font-size: var(--font-size-h6);
                    margin-bottom: var(--spacing-md);
                    max-width: 85ch;
                }

                & ul,
                & ol {
                    margin: var(--spacing-md) 0;
                    padding-left: var(--spacing-lg);

                    & li {
                        margin-bottom: 0.75rem;
                        font-size: var(--font-size-h6);
                    }
                }

                /* Images - Desktop optimiert */
                & img {
                    margin: var(--spacing-lg) auto;
                    border-radius: 0.75rem;
                    max-width: 85%;

                    &:hover {
                        transform: scale(1.02);
                    }
                }

                & pre {
                    padding: var(--spacing-md);
                    margin: var(--spacing-lg) 0;
                    border-radius: 0.75rem;
                    font-size: 0.9rem;
                }

                /* Tabellen - Desktop: Bessere Tabellen-Darstellung */
                & table {
                    margin: var(--spacing-lg) 0;
                    border-radius: 0.75rem;
                    font-size: 0.9rem;
                    display: table;
                    white-space: normal;
                    table-layout: auto;

                    & th {
                        padding: var(--spacing-sm);
                        font-size: 0.9rem;
                        width: auto;
                    }

                    & td {
                        padding: var(--spacing-sm);
                        width: auto;
                    }
                }

                & blockquote {
                    padding: var(--spacing-md);
                    margin: var(--spacing-lg) 0;
                    border-radius: 0 0.75rem 0.75rem 0;
                    font-size: 1rem;
                }

                & hr {
                    margin: var(--spacing-xxl) 0;
                    height: 2px;
                    background: linear-gradient(
                        90deg,
                        transparent,
                        var(--color-border),
                        transparent
                    );
                }
            }
        }
    }
</style>
