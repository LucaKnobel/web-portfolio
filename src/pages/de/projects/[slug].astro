---
import { getProjectDetail } from "@/content/get-project-detail.ts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ErrorPage from "@/components/ErrorPage.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import ProjectDetail from "@/components/ProjectDetail.astro";

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);

if (!lang || !slug) {
  Astro.response.status = 404;
}

const t = useTranslations(lang);

let detail;
try {
  detail = await getProjectDetail(lang, slug ?? "");
} catch (err) {
  Astro.response.status = 500;
}

const project = detail?.project;
const Content = detail?.Content;
if (!project || !Content) {
  Astro.response.status = Astro.response.status === 500 ? 500 : 404;
}
const errorStatus = Astro.response.status === 500 ? 500 : 404;
---

<BaseLayout
  title={project
    ? `Luca Knobel | ${project.data.title}`
    : `Luca Knobel | ${errorStatus === 500 ? t("500.pageTitle") : t("404.pageTitle")}`}
>
  {
    project && Content ? (
      <ProjectDetail project={project} lang={lang} t={t} Content={Content} />
    ) : (
      <ErrorPage status={errorStatus} />
    )
  }
</BaseLayout>
