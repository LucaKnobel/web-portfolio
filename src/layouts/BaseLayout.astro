---
import Header from "@/components/Header.astro"
const { title = "Portfolio" } = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
    </head>
    <body>
        <Header></Header>
        <slot />
    </body>
</html>
